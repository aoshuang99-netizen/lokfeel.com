# ═══════════════════════════════════════════════════════
# PingPong Checkout Configuration
# ═══════════════════════════════════════════════════════

# ── PingPong API Credentials ──
# Get from: https://my.pingpong.one/integrations/api/
# 🔴 2026-11-06：此处曾明文写入真实 sandbox 凭据，已脱敏并登记轮换
#    （见 docs/SECRET-ROTATION-CHECKLIST.md）。请用你自己的凭据替换下列占位。
PINGPONG_API_KEY="your-pingpong-api-key"
PINGPONG_API_SECRET="your-pingpong-api-secret"
PINGPONG_MERCHANT_ID="your-merchant-id"

# ── PingPong Environment ──
# Sandbox: https://gateway-test.pingpongx.com
# Production: https://gateway.pingpongx.com
PINGPONG_ENVIRONMENT="sandbox" # or "production"

# ── PingPong Webhook ──
PINGPONG_WEBHOOK_SECRET="your-webhook-secret"

# ── PingPong Subscription Plan IDs ──
# Create in PingPong Dashboard → Subscription Plans
PINGPONG_MONTHLY_PLAN_ID="plan_monthly_xxxxx"
PINGPONG_YEARLY_PLAN_ID="plan_yearly_xxxxx"
