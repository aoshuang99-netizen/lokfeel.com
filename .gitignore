# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.production
.env.production.local
.env.development.local
.env.test.local

# vercel
.vercel
.env.vercel.local

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
test-results/
playwright/.cache/
dev.db:*
.env*.local

# opennext / cloudflare workers
/.open-next/
.dev.vars
cloudflare-env.d.ts
.cf-secrets.json

# chat-merge 门禁的合成正控夹具（运行期创建、finally 清理；进程被 kill 时可能残留）
/.stage5-probe/

# 生产数据备份（阶段 5 删表前的三表快照等）—— 绝不能进仓库
/backups/
/deploy-tasks/

# Bot 生成数据不入仓库（定位 ③）；本地保留仅供维护脚本使用
/public/bot-avatars/

# 残留备份文件（D7，2026-09-29）：已从跟踪中移除，本地保留
*.backup
*.backup-*
*.bak

# 数据迁移回滚快照（scripts/qa/*-migration / *-vocab --apply 产出）—— 含生产用户数据，绝不能进仓库
.gender-migration-backup-*.json
*-migration-backup-*.json

# QA 测试账号凭据（本地专用，public 仓库绝不入库）
.qa-credentials.local.json
.wrangler/

# QA 清理脚本的自动备份（含用户数据，不入库）
.qa-cleanup-backup-*.json
# 清理前额外导出的 CASCADE 子表（Profile / Subscription / Membership）—— 同样含用户数据
.qa-refs-backup-*.json

# Cloudflare Realtime TURN Key 备份（正常运行落在 ~/.lokfeel-turn-keys/，
# 这里防的是有人误把它拷进仓库 —— 含机密，一旦入库等于永久泄露）
.lokfeel-turn-keys/
.turn-key-*.json

# 自证脚本的临时产物（`verify:workspace-drift` / `verify:ui-invariants`）：
# 正常路径下脚本自己创建、自己清理；被中断（OOM / Ctrl-C）时会**残留**在
# 仓库根或源码树里 —— 此时 `git add -A` 会把它当成"正常文件"提交。
#   · tsconfig.drift-probe.json —— 漂移探针（根目录）
#   · __mutant-*               —— 变异体（源码树内，UI 门禁 R0 也会主动报错）
tsconfig.drift-probe.json
__mutant-*

# 性能基线的隔离库（AC-24，`scripts/perf/prepare-env.sh` 创建）：
# 与上面同一条教训 —— 它是**可丢弃的本地库**，不是交付物。
# 基线数据本身是 `docs/implementation/perf-baseline.json`（那个**要**提交）。
perf-baseline.db
perf-baseline.db-journal
perf-baseline.db-wal
perf-baseline.db-shm
/reports/

# V17 本地依赖备份（不提交）
.nm-broken-v17/
