# ═══════════════════════════════════════════
# LokFee! — Environment Variables Template
# Copy to .env.local and fill in real values
# ═══════════════════════════════════════════

# ── Database (Turso) ──
DATABASE_URL=libsql://your-db-name-your-org.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── NextAuth ──
AUTH_SECRET=your-32-char-secret-here
AUTH_URL=https://app.lokfeel.com
NEXTAUTH_URL=https://app.lokfeel.com

# ── App URLs ──
NEXT_PUBLIC_APP_URL=https://app.lokfeel.com
NEXT_PUBLIC_APP_NAME=LokFee!

# ── Google OAuth (REQUIRED for Google Login) ──
# Get from: https://console.cloud.google.com → Credentials → OAuth 2.0
# Authorized redirect URI: https://app.lokfeel.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── X/Twitter OAuth 2.0 (REQUIRED for X Login) ──
# Get from: https://developer.twitter.com → Projects & Apps → Keys and tokens
# Callback URI: https://app.lokfeel.com/api/auth/callback/twitter
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# ── Google Tag Manager (Optional) ──
# Get from: https://tagmanager.google.com → Container ID (GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# ── Email (SMTP) ──
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=your-resend-api-key
SMTP_FROM=hello@lokfeel.com

# ── Cron Jobs ──
CRON_SECRET=your-cron-secret-here
