    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "webrtc-adapter": "^9.0.6",
    "ws": "^8.21.3",
    "zod": "4.3.6",
    "zustand": "^5.0.15"
