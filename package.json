{
  "name": "nexus-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3099",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest tests/integration",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset",
    "postinstall": "npx prisma generate",
    "bots:import": "npx tsx scripts/import-bot-users.ts",
    "bots:avatars": "npx tsx scripts/generate-bot-avatars.ts",
    "bots:simulate": "npx tsx scripts/simulate-bot-activity.ts",
    "bots:train": "npx tsx scripts/matching-engine-training.ts",
