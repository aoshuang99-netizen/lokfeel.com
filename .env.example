# ═══════════════════════════════════════════
# Nexus App — Environment Variables
# Copy to .env.local and fill in real values
# ═══════════════════════════════════════════

# ── Database (Neon PostgreSQL recommended) ──
# Get from: https://neon.tech → New Project → Connection String
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/nexus?sslmode=require"

# ── NextAuth / Auth.js ──
# Generate secret: openssl rand -base64 32
AUTH_SECRET="your-random-32-char-secret-here"
NEXTAUTH_URL="https://nexus-app.vercel.app"
AUTH_URL="https://nexus-app.vercel.app"

# ── App URLs ──
NEXT_PUBLIC_APP_URL="https://nexus-app.vercel.app"
NEXT_PUBLIC_APP_NAME="Nexus"

# ── Google OAuth ──
# Get from: https://console.cloud.google.com → Credentials → OAuth 2.0
# Authorized redirect URI: https://app.lokfeel.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── LinkedIn OAuth ──
# Get from: https://www.linkedin.com/developers/apps
# Authorized redirect URI: https://app.lokfeel.com/api/auth/linkedin
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="https://app.lokfeel.com/api/auth/linkedin"

# ── Facebook OAuth ──
# Get from: https://developers.facebook.com/apps
# Authorized redirect URI: https://app.lokfeel.com/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ── Discord OAuth ──
# Get from: https://discord.com/developers/applications
# Authorized redirect URI: https://app.lokfeel.com/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ── Firebase Auth (Google One Tap + Apple Sign-In) ──
# Client SDK — Get from: Firebase Console → Project Settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Admin SDK — Get from: Firebase Console → Project Settings → Service Accounts → Generate New Key
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ── Email (SMTP) for verification codes ──
# Get from: https://resend.com or https://sendgrid.com
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASSWORD=""
SMTP_FROM="hello@lokfeel.com"

# ── Stripe (for subscriptions) ──
# Get from: https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PREMIUM_MONTHLY_PRICE_ID="price_..."
STRIPE_PREMIUM_YEARLY_PRICE_ID="price_..."
STRIPE_LIFETIME_PRICE_ID="price_..."

# ── Pusher（实时消息 + 视频通话信令）──
# 获取：https://pusher.com → Create App → Keys
# 注意服务端用的是 PUSHER_APP_ID / PUSHER_KEY / PUSHER_SECRET / PUSHER_CLUSTER
# （客户端另需 NEXT_PUBLIC_PUSHER_KEY / NEXT_PUBLIC_PUSHER_CLUSTER）。
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# 实时通道的**关闭开关**（opt-out，默认开启）。
# 真正的判据是「Pusher key 是否为空」：key 为空时客户端会自动禁用。
# 只在需要临时关停（自托管/排障/控制 Pusher 用量）时设为 "false"。
# ⚠️ 不要写成 "true" 来"开启"——留空即为开启；历史上因为要求显式 true
#    而生产漏设，导致实时消息与视频通话整体静默失效。
NEXT_PUBLIC_USE_PUSHER=""

# ── TURN（视频通话穿透对称 NAT）──
#
# ✅ 生产推荐：**服务端**三项（不带 NEXT_PUBLIC_，凭据不进前端 bundle）
#    由 GET /api/rtc/ice-servers 按需签发。三项齐备即生效，且优先级最高
#    （会顶掉 Cloudflare 兜底，所以改动前必须跑 verify:turn:candidate）。
#    切换步骤见 docs/TURN-SELF-HOST-SWITCH-2026-10-09.md
#
#    留空 = 走 Cloudflare 公共 TURN 兜底（speed.cloudflare.com/turn-creds，1000GB/月免费）
#    仅 STUN 也无法返回时也不会失败，只是对称 NAT 下可能连不上。
TURN_URLS=""            # 逗号分隔，例：turn:t.example.com:3478?transport=udp,turns:t.example.com:443
TURN_USERNAME=""
TURN_CREDENTIAL=""

# ✅ 终局推荐：**Cloudflare Realtime TURN**（$0.05/GB，前 1000 GB/月免费，anycast，有合同）
#    一次性创建 Key：node scripts/setup-cloudflare-turn.mjs（会写入下面两项）
#    生效位置在「服务端静态覆写」之后、「speed.cloudflare.com 兜底」之前：
#      配了就用它；没配 或 签发失败 → 自动降级到兜底，**不影响现有可用性**。
#    ⚠️ 两项均为**服务端机密**，绝不加 NEXT_PUBLIC_ 前缀（否则内联进前端 bundle）。
TURN_TOKEN_ID=""        # Cloudflare Realtime TURN Key 的 uid（非机密）
TURN_API_TOKEN=""       # 对应 Key 的 API Token（**机密**）

# ⚠️ 以下 NEXT_PUBLIC_TURN_* 为**历史兼容**，仅用于临时自测。
#    不要在生产使用：NEXT_PUBLIC_* 会被内联进前端 bundle，长期凭据等于公开。
#    三项都齐备且 USE_TURN=true 时才追加到静态兜底列表（静态兜底仅在
#    /api/rtc/ice-servers 不可达时才会被用到）。
NEXT_PUBLIC_USE_TURN="false"
NEXT_PUBLIC_TURN_URLS=""          # 逗号分隔，缺省用 turn.metered.ca
NEXT_PUBLIC_TURN_USERNAME=""
NEXT_PUBLIC_TURN_CREDENTIAL=""

# ── Upload (Uploadthing — for profile photos) ──
# Get from: https://uploadthing.com → Create App
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# ── Cron Jobs (Vercel Cron authentication) ──
# Generate secret: openssl rand -base64 32
# Must match Authorization: Bearer <CRON_SECRET> header sent by Vercel Cron
CRON_SECRET=""

# ─── Google Tag Manager (Optional) ───
# Get from: https://tagmanager.google.com → Container ID (GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=""

# ─── Sentry Error Monitoring (Optional) ───
# Get from: https://sentry.io → Settings → Projects → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=""

# ═══════════════════════════════════════════
# 地域 / CORS / 缓存策略（P0-6 · 全部可选）
#
# 这些规则原先硬编码在 proxy.ts 里；现在由部署方通过环境变量决定。
# **全部留空 = 与改造前完全一致**（不封禁任何地区、三个正式域名可跨域）。
# 改完可跑：npm run verify:geo
# ═══════════════════════════════════════════

# ── 地域封禁（黑名单模式）──
# 逗号分隔的 ISO-3166 alpha-2 国家码。留空 = 不启用地域封禁。
# ⚠️ 全域国家封禁属于合规决策，启用前请做法务复核。
GEO_BLOCKED_COUNTRIES=""

# ── 地域封禁（白名单模式，优先于黑名单）──
# 只允许这些国家访问。与 GEO_BLOCKED_COUNTRIES 同时配置时以本项为准（更严格）。
GEO_ALLOWED_COUNTRIES=""

# ── IP 白名单（运维免检通道）──
# 精确 IP 或前缀通配（如 203.0.113.7 / 198.51.100.*）。
# 优先级高于国家判定 —— 否则被封地区的运营者连自己的后台都进不去。
GEO_IP_WHITELIST=""

# ── 取不到国家码时如何处理（自托管常无 geo 头）──
# allow（默认）| block
GEO_UNKNOWN_COUNTRY="allow"

# ── 封禁时 API 是否返回 451 JSON（而非 302 跳 HTML）──
# 默认 true。设为 0 会让 API 也跳转到 /blocked，客户端 fetch().json() 会解析失败。
GEO_API_RETURNS_451=""

# ── 封禁地区也始终放行的路径（逗号分隔；/blocked 为精确匹配，其余前缀匹配）──
# 一般不需要设置，留空用内置默认值。
GEO_ALLOWED_PATHS=""

# ── CORS 允许的 origin（逗号分隔）──
# 留空 = 内置默认（app.lokfeel.com / lokfeel.com / admin.lokfeel.com）。
# 自托管/白标部署请改成自己的域名。
CORS_ALLOWED_ORIGINS=""

# ── 是否额外放行 localhost / 127.0.0.1（默认 1）──
CORS_ALLOW_LOCALHOST=""

# ── 预览环境 origin 的正则（留空则关闭预览放行）──
# 留空 = 内置默认（Vercel 预览域名）。自托管部署建议留空。
CORS_PREVIEW_ORIGIN_PATTERN=""

# ═══════════════════════════════════════════
# Bot 演示模块（P0-5 · 默认关闭）
#
# 这是一套**默认关闭的可选模块**：机器人/演示账号体系（BotProfile 等 6 张表 +
# api/cron/bot-* + api/bot-automation）。开源版不启用它 ——
# 一个"用户数靠机器人堆出来"的系统与开源信誉直接冲突。
#
# 本文件是**发行物**，因此这里的取值是 false：`cp .env.example .env` 得到的就是关闭状态。
# （代码在**未设置**该变量时仍沿用改造前行为=启用，以免存量部署静默失去能力；
#   这一对默认值由 `npm run verify:bot` 断言守住。）
# ═══════════════════════════════════════════

# ── Bot 模块总开关 ──
# false（本文件默认）| true
# 关闭后：/api/cron/bot-*、/api/bots/status、/api/bots/learning/stats、/api/bot-automation
#         统一返回 503（响应体含 disabledReason 与启用指引）。
# ⚠️ 合法取值：true/false、1/0、yes/no、on/off、enable/disable。
#    取值无法识别时按 **fail-closed**（关闭）处理，并会写进 /api/health 的告警里。
BOT_ENGINE_ENABLED="false"

# ── 引擎运行参数（留空 = 内置默认，等于改造前写死在 bot-tick 路由里的取值）──
# Tick 间隔（毫秒，默认 60000）
BOT_TICK_INTERVAL_MS=""
# 单次 tick 最多处理动作数（默认 50；Serverless 环境建议 ≤ 100）
BOT_MAX_ACTIONS_PER_TICK=""
# 同一 Bot 两次动作的最小间隔（毫秒，默认 30000）
BOT_MIN_ACTION_INTERVAL_MS=""
# 时间倍率（默认 1 = 实时）。>1 会成倍放大写库量，仅演示/压测使用
BOT_SPEED_MULTIPLIER=""

# ── Netlify 运维看门狗（仅供 scripts/netlify-credit-watch.mjs 使用，应用运行时不读）──
# 用途：轮询团队额度，在耗尽前告警。Netlify 的 auto_topup_enabled /
# credit_alert_percentage **无法通过 API 写入**（实测 PATCH/PUT 返 200 但值不变），
# 只能在控制台 UI 开启，故用本脚本做等效兜底。
#   NETLIFY_AUTH_TOKEN=... npm run netlify:credits
# ⚠️ 本仓库是 public：此变量**只允许存在于本地环境/CI secret**，绝不提交真实值。
#    未设置时脚本会直接退出并提示，不会使用任何内置凭据。
NETLIFY_AUTH_TOKEN=""
# 团队 slug（默认 aoshuang99）
NETLIFY_ACCOUNT_SLUG=""
# 告警/危急阈值百分比（默认 80 / 95）
CREDIT_WARN_PCT=""
CREDIT_CRIT_PCT=""
