{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma generate && next build",
  "framework": "nextjs",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/bot-tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/bot-online",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/bot-chat",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/bot-match",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/bot-learning",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/cleanup-soft-delete",
      "schedule": "0 2 * * *"
    }
  ]
}
