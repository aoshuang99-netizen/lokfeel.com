// ═══════════════════════════════════════════════════════════════
// CONNECTION OS — 业务闭环实体（自 T02 起逐任务追加）
//
// 对齐契约：
//   - contracts/schema.sql:15-20   (missions)
//   - contracts/connection.openapi.yaml  /missions 与 /v1/missions/{missionId}
//
// 设计约束（继承 T01 的 tenancy.prisma，见 docs/implementation/T01/DIALECT-DIFF.md）：
//   1. **方言无关**：本文件不出现任何 `@db.*` 原生类型标注。同一份定义可同时为
//      libSQL（当前生产）与 PostgreSQL（M6 目标）生成；差异只体现在迁移 SQL。
//   2. **复合语义字段走 `String` + 单点 codec**：libSQL 无 `jsonb`，契约里的
//      `jsonb` 一律落为 JSON 文本，编解码**只允许**经 `src/lib/connection/json-codec.ts`。
//      散落的 `JSON.parse` 会导致「有的存字符串、有的存对象」的静默腐化。
//   3. **`organizationId` 一律由服务端从会话派生**（`resolveTenant()`），
//      绝不接受客户端传入值作为授权依据。
//   4. **加列优先 / 只增不改**：新任务只往本文件加模型；改动既有列语义需走 MIGRATION_PLAN。
// ═══════════════════════════════════════════════════════════════

/// Mission 生命周期。契约 missions.status 为自由 text（默认 'draft'），
/// 这里收敛为枚举 —— 取值与 `src/lib/connection/missions.ts` 的状态机逐字一致。
enum MissionStatus {
  DRAFT // 草稿：不可分享，分享链接返回 404
  ACTIVE // 已发布：分享页可访问，可被加入
  PAUSED // 已暂停：分享页只读，拒绝新加入（保留历史）
  CLOSED // 已关闭：分享页只读，终止
}

/// 成员加入 Mission 的状态。
/// ⚠️ 与 T03 的 `SocialIntent` 分工：本模型只表达「谁加入了哪个任务」（粗粒度、必填），
/// `SocialIntent` 表达「该成员的 need/offer/逐字段披露范围」（细粒度，T03 交付）。
/// 二者是 1:1 互补关系，不是重复建模。
enum MissionParticipationStatus {
  INTERESTED // 已加入/表达参与意愿
  WITHDRAWN // 本人撤销
  REMOVED // 运营移出
}

/// 连接任务。对应契约 missions 表。
model Mission {
  id             String @id @default(cuid())
  /// 租户归属。**必填**（T01 起新表直接带上，不再走加列批次）。
  organizationId String
  /// 任务发起人。契约 persons 同义于本仓 `User`。
  ownerId        String

  title String
  goal  String
  offer String
  /// 约束（JSON 文本，字符串数组）。**必须**经 json-codec 读写。
  constraints String?
  /// 成功标准：验收「连接是否达成」的判据（PRD 要求可判定，非口号）。
  successCriteria String

  status MissionStatus @default(DRAFT)

  /// 分享令牌：`/m/<shareToken>` 的唯一寻址方式。
  /// 高熵、不可枚举、URL-safe；**即能力凭证**，故不可预测、不可自增。
  shareToken String @unique
  /// 是否允许**未注册**访客预览（最小披露）。关闭后分享页一律要求登录。
  publicPreview Boolean @default(true)

  /// 限额。null = 不限。
  maxParticipants Int?

  expiresAt   DateTime? // 截止（过期后分享页只读、拒绝新加入）
  publishedAt DateTime? // 首次 publish 时间
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User                   @relation("UserMissions", fields: [ownerId], references: [id], onDelete: Cascade)
  participations MissionParticipation[]
  socialIntents  SocialIntent[]
  proposals      ConnectionProposal[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════════
// T03 · SocialIntent —— 成员意图与**逐字段披露**
//
// 与 MissionParticipation 的分工（不是重复建模）：
//   - MissionParticipation：粗粒度「谁加入了哪个任务」（T02，必填、可计数）
//   - SocialIntent：       细粒度「该成员的 need/offer/约束/有效期 + 逐字段可见范围」（T03）
//   二者 1:1 互补；意图必须挂在一条已加入的参与关系之下（父锚点 `missionId + userId`）。
//
// 安全取向（AC-03 是 BLOCKER）：**默认拒绝**。`disclosure` 里没写的字段一律按
// field-catalog 的 defaultAudience 处理，而目录中每个字段的默认值都是 `SELF`
// （即不披露）。「用户没选」**绝不**等价于「用户同意」。
// ═══════════════════════════════════════════════════════════════

/// 意图生命周期。**只有本人能改**；`WITHDRAWN` 是终态（重新参与须显式 reactivate）。
///
/// 「已过期」**刻意不落库**：它由 `expiresAt` 与当前时间**派生**
/// （见 `intents.ts` 的 `deriveIntentStatus()`）。若把它做成存储状态，
/// 就必须依赖定时任务翻状态 —— 定时任务一旦停摆，「过期」会静默失效，
/// 而已过期意图仍在被披露。派生状态没有这个失败模式。
enum IntentStatus {
  ACTIVE // 生效中：可被披露、可进入匹配
  WITHDRAWN // 本人撤销：不再披露，且不可编辑（须 reactivate 显式复活）
}

/// 逐字段披露的受众档位。**档位是包含式的**（档位越高 = 允许看到的人越多）：
///   SELF          → 仅本人（= 不披露）
///   ORGANIZER     → 本人 + 组织者
///   COUNTERPARTY  → 本人 + 组织者 + **已双向同意**的对手方（T05 起）
///   CANDIDATE     → 本人 + 组织者 + 同任务的互补伙伴（T04 起；最宽）
/// 因此"某受众能否看到" = `rank(granted) >= rank(viewer)`。
///
/// ⚠️ 为什么 `CANDIDATE` 排在 `COUNTERPARTY` **之后**（而不是"候选比对手方窄"）：
///   记 `C` = 已同意的对手方集合，`P` = 同任务的互补伙伴集合。**`C ⊆ P`** ——
///   任何已同意的对手方，在同意之前本来就是一名候选伙伴。于是
///   `{组织者}+C ⊆ {组织者}+P`，即"给已同意者看" ⊂ "给伙伴看"。
///   `CANDIDATE` 因此是**更宽**的一档，必须追加在末尾。
///   若误以为"候选更窄"而把它插在 `COUNTERPARTY` 之前，就会出现
///   `rank(COUNTERPARTY) >= rank(CANDIDATE)` → **尚未同意的人看到了用户
///   只授权给已同意对手方的字段** —— 一次静默的越权披露。
///
/// ⚠️ 新增档位时**不得改变已存在档位的相对次序**：库里存的是档位**名字**，
///   理解名字的是本次序；次序一变，历史数据的可见性会静默漂移，
///   且没有任何迁移能"顺便修好"它。（`CANDIDATE` 追加在末尾即满足此约束。）
///
/// 用 `///` 是为了让这条规则进入生成的 Client 类型提示，避免调用方凭直觉猜方向。
enum DisclosureAudience {
  SELF // 仅本人可见（= 不披露）
  ORGANIZER // 任务组织者 / 运营
  COUNTERPARTY // 双向同意后的对手方（T05 起生效）
  CANDIDATE // 同任务的互补伙伴（尚未同意；T04 起生效，最宽）
}

/// 成员意图。对应契约 social_intents 表的语义（契约挂在 organization 上，
/// 本仓显式挂到 Mission —— 意图脱离具体任务没有业务含义，且 mission 级才能做名额/披露判定）。
model SocialIntent {
  id             String @id @default(cuid())
  organizationId String
  /// 父锚点：T02 的 Mission。任务删除时意图级联删除。
  missionId      String
  /// 提交者。**必须**是该 Mission 所属租户的 ACTIVE 成员（服务端回查 memberships）。
  userId         String

  /// 我需要什么（Mission 的 goal 是"发起方要什么"，这里是"协作者要什么"）。
  need  String
  /// 我能提供什么。
  offer String
  /// 附加约束（JSON 文本，字符串数组）。**必须**经 json-codec 读写。
  constraints String?

  /// 逐字段披露表（JSON 文本）：`{ "<fieldKey>": "SELF"|"ORGANIZER"|"CANDIDATE"|"COUNTERPARTY" }`。
  ///
  /// 语义：**缺失的键 = 未授权**（落到目录默认值 SELF），不在这里补默认值 ——
  /// 「写库时补默认」会把"用户没选"悄悄固化成"系统认为他同意了"。
  disclosure String?

  status IntentStatus @default(ACTIVE)

  /// 有效期。null = 不过期。过期后**仍可编辑续期**，但不再被披露（派生为 EXPIRED）。
  expiresAt   DateTime?
  withdrawnAt DateTime?

  /// ── 导入许可留痕（AC-12「用户主动授权」的落点）──
  /// 用户显式同意「从账户档案导入字段」的**时间戳**。null = 从未同意，
  /// 此时任何 `importFromProfile` 请求都必须被拒（400），不得默认放行。
  importConsentAt DateTime?
  /// 实际从档案导入的字段名（JSON 文本数组）。与 `disclosure` **分开存储**：
  /// 一个记"数据从哪来"、一个记"给谁看"。混在一起会导致"撤回导入"误删披露设置。
  importedFields  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mission      Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user         User         @relation("UserSocialIntents", fields: [userId], references: [id], onDelete: Cascade)

  /// 同一任务同一成员只有一条意图 —— 幂等提交/编辑的落点。
  @@unique([missionId, userId])
  @@index([organizationId, status])
  @@index([organizationId, missionId])
  @@index([userId, status])
  @@index([expiresAt])
}

/// 成员 × Mission 的加入关系。契约中没有独立表（契约把 memberships 与
/// social_intents 直接挂 organization），这里显式建模是为了：
///   1. 让「加入」可计数、可撤销、可审计（AC-11 的加入动作需要落库）；
///   2. 给 T03 的 `SocialIntent` 一个稳定的父锚点（`missionId` + `userId`）。
model MissionParticipation {
  id             String                     @id @default(cuid())
  organizationId String
  missionId      String
  userId         String
  status         MissionParticipationStatus @default(INTERESTED)
  /// 加入时的可选留言（最小披露：不进入公开投影）。
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mission      Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user         User         @relation("UserMissionParticipations", fields: [userId], references: [id], onDelete: Cascade)

  /// 同一任务同一成员只能有一条加入记录（幂等 join 的落点）。
  @@unique([missionId, userId])
  @@index([organizationId, status])
  @@index([userId, status])
}

/// 幂等记录。契约对 `POST /missions` 强制要求 `Idempotency-Key` 请求头
/// （connection.openapi.yaml:12-19）。同样的键重复提交必须返回**首次结果**，
/// 不得创建第二条 Mission —— 这是 AC-07（幂等）在本任务的最小落点。
///
/// 键空间是 `(organizationId, scope, key)`：同一把 key 在不同租户/不同业务动作下
/// 互不干扰，避免跨租户串号。
model IdempotencyRecord {
  id             String @id @default(cuid())
  organizationId String
  /// 业务动作，如 `mission.create` / `mission.join`。
  scope String
  /// 客户端提交的 Idempotency-Key 原文。
  key String
  /// 请求体指纹（sha256）。同一 key 配不同请求体 → 409（防止「键复用了但意图变了」）。
  requestHash String
  resourceType String
  resourceId   String?
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, key])
  @@index([organizationId, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// T05 · 双边同意（Consent & Trust）—— AC-04 / AC-05 / AC-06
//
// 契约对应：
//   - contracts/schema.sql:693-704   (connection_proposals / proposal_decisions)
//   - contracts/connection.openapi.yaml   POST /connections/proposals、
//     POST /connections/{connectionId}/consent、POST /connections/{connectionId}/revoke
//
// ⚠️ **为什么不复用 core.prisma 的 `ConsentRequest` / `ConsentGrant`**
//   （卡片写"可复用"，此处是逐条核对后的判定，不是偷懒新造表）：
//   那两个模型是 **IM 媒体访问权限** —— `consentType: MEDIA`、
//   `requestedLevel/grantedLevel: L0_TEXT | …`、外键 `conversationId` 挂在**会话**上，
//   语义是"允许对方看我的摄像头 / 麦克风 / 加密消息"。
//   本任务要表达的是"**组织者牵线，与另一个人建立连接**"：没有会话、没有媒体档位、
//   参与者是「提案双方」而非「会话双方」。
//   硬塞进 `ConsentRequest` 需要把 `conversationId` 改成可空、并给 `consentType`
//   加一个与 `MEDIA` 并列的取值 —— 结果是**两个语义域共用一张表**：
//   媒体权限的查询会捞到连接提案，反之亦然（且没有任何编译期信号）。
//   契约本身把二者分表（`consent_grants` vs `connection_proposals`），本仓遵循契约。
//   可以复用的是**模式**而非表：拒绝即关闭、撤销清空待发、执行前再校验。
// ═══════════════════════════════════════════════════════════════

/// 连接提案的生命周期。
///
/// ⚠️ 与 T03 `IntentStatus` 的根本差别：这是**双人**状态机。
///   单人同意**不改变**"待决"这一事实 —— `CONSENT_PENDING` 会跨越第一次 accept。
///   因此"能否介绍"的判据**不是** "有人同意了"，而是 `MUTUALLY_ACCEPTED`
///   （AC-04：单方接受不得发送正式介绍）。
enum ConnectionProposalStatus {
  CONSENT_PENDING // 待决：至少一方尚未表态（刚创建时即此态）
  MUTUALLY_ACCEPTED // 双方均已接受 —— **"可介绍"的唯一状态**
  REJECTED // 任一方拒绝：终态，之后任何表态一律 409
  REVOKED // 任一方撤销：终态；也可从 MUTUALLY_ACCEPTED 撤销（AC-05）
}

/// 个体表态类型。对应契约 `proposal_decisions.decision CHECK IN ('accept','reject','revoke')`。
enum ProposalDecisionKind {
  ACCEPT
  REJECT
  REVOKE
}

/// 连接提案。对应契约 `connection_proposals` 表。
model ConnectionProposal {
  id             String @id @default(cuid())
  organizationId String
  /// 提案依附的 Mission —— 互补关系是在某条任务下被发现并牵线的。
  missionId      String

  /// 发起方。**必须**是同租户 ACTIVE 成员且具备 `proposal.create`（T01 定为 OPERATOR+）。
  proposerId     String
  /// 被介绍方。**必须**是同租户 ACTIVE 成员，且与发起方不是同一人（契约 CHECK 的等价约束）。
  candidateId    String

  status ConnectionProposalStatus @default(CONSENT_PENDING)

  /// 发起理由。**会展示给被介绍方** —— 这是对方决定"要不要同意"的唯一依据，
  /// 故必填（契约 `rationale text NOT NULL`）。不得写入内部判断或他人隐私。
  rationale String

  /// 提案有效期。null = 不过期。
  /// ⚠️ AC-06：**执行（介绍）时必须再校验一次本字段**，不能只在创建时校验 ——
  /// 提案完全可能在"双方都同意"与"真正介绍"之间失效。
  expiresAt DateTime?

  /// 介绍落地时间。null = 尚未介绍。写入即代表"连接已建立"，T06 据此驱动后续工作流。
  introducedAt DateTime?
  /// 关闭时间（进入 REJECTED / REVOKED 时写入），用于审计与"提案存活时长"统计。
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mission      Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  proposer     User         @relation("ProposalProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  candidate    User         @relation("ProposalCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  decisions    ProposalDecision[]

  /// 同一对（发起方 → 被介绍方）在同一任务下**只能有一条提案**。
  /// 这同时是"重复发起"的最后一道兜底：即便客户端换了 `Idempotency-Key`，
  /// 也不会为同一对搭档堆出多条并行同意流程 —— 那会把"双方同意"退化成
  /// "同意其中一条"，而另外几条仍在待决（用户看到的界面会自相矛盾）。
  @@unique([missionId, proposerId, candidateId])
  @@index([organizationId, status])
  @@index([organizationId, missionId])
  @@index([proposerId, status])
  @@index([candidateId, status])
  @@index([expiresAt])
}

/// 个体表态记录。契约 `PRIMARY KEY(proposal_id, person_id)` —— 每人每提案**至多一行**。
///
/// 语义：这是「**当前**表态」，不是「表态流水」。同一人先 accept 后 revoke 时，
/// 本行被**覆盖**（AC-05 的撤销即由此实现），而不是追加一行 ——
/// 保留流水会把"谁在什么时候改过主意"变成永久记录，那不是本任务要收集的数据。
/// 需要不可抵赖的追加式记录请走 `TenantAuditEvent`（写入失败不影响业务）。
model ProposalDecision {
  id             String @id @default(cuid())
  organizationId String
  proposalId     String
  /// 表态人。服务层**必须**校验其 ∈ {proposerId, candidateId}（非参与者 → 403，不得 404 —— 
  /// 提案对非参与者而言是"存在但不关你的事"，与跨租户的"不存在"是两种不同的答复）。
  personId String

  decision  ProposalDecisionKind
  /// 可选说明。**不返回给对侧** —— 否则"拒绝理由"就成了一次计划外的信息披露。
  note      String?
  decidedAt DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal     ConnectionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  person       User               @relation("UserProposalDecisions", fields: [personId], references: [id], onDelete: Cascade)

  @@unique([proposalId, personId])
  @@index([organizationId])
  @@index([personId, decidedAt])
  @@index([decision])
}
