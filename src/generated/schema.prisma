// ═══════════════════════════════════════════════════════════════
// PRODUCT OPTIMIZATION: Sincerity System & Vault
// ═══════════════════════════════════════════════════════════════

enum VaultStatus {
  ACTIVE // 正常进行中
  EXTENDED // 已延长
  REVOKED // 被女性终止
  EXPIRED // 时间到自动关闭
}

enum SincerityTransactionType {
  EARN // 赚取
  SPEND // 消费
  RECEIVE_GIFT // 收到礼物
  SEND_GIFT // 送出礼物
  REFUND // 退款
}

model SincerityWallet {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Balance
  balance       Int @default(0) // 当前余额
  totalEarned   Int @default(0) // 累计获得
  totalSpent    Int @default(0) // 累计消费
  totalGifted   Int @default(0) // 累计送出礼物
  totalReceived Int @default(0) // 累计收到礼物

  // Tier System
  tier         SincerityTier @default(BRONZE)
  tierProgress Float         @default(0) // 到下一级的进度 0-100

  // Stats
  lastEarnedAt DateTime?
  lastSpentAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transactions SincerityTransaction[]

  @@index([tier])
  @@index([balance])
}

model SincerityTransaction {
  id       String          @id @default(cuid())
  walletId String
  wallet   SincerityWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  // Transaction Details
  type   SincerityTransactionType
  amount Int

  // Source/Reason
  source      String // "PROFILE_COMPLETE", "DAILY_LOGIN", "MATCH_ACCEPTED", "PITCH_SEND", etc.
  description String? // 用户可见的描述

  // Related Entities
  matchId    String? // 关联的匹配
  fromUserId String? // 送礼人
  toUserId   String? // 收礼人
  message    String? // 附言

  // Metadata
  metadata String? // JSON for additional data

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([type])
  @@index([createdAt])
  @@index([source])
}

enum SincerityTier {
  BRONZE // 0-499
  SILVER // 500-1999
  GOLD // 2000-4999
  PLATINUM // 5000+
}

// ═══════════════════════════════════════════════════════════════
// SAFETY & MODERATION — User Block List
// ═══════════════════════════════════════════════════════════════

model Block {
  id        String @id @default(cuid())
  blockerId String // User who blocks
  blocker   User   @relation("BlockerRelations", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String // User who is blocked
  blocked   User   @relation("BlockedRelations", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Prevent duplicate blocks
  @@unique([blockerId, blockedId], name: "unique_block_pair")
  @@index([blockerId])
  @@index([blockedId])
}

// ═══════════════════════════════════════════════════════════════
// SAFETY & MODERATION — User Reports
// ═══════════════════════════════════════════════════════════════

enum ReportReason {
  INAPPROPRIATE_CONTENT
  HARASSMENT
  FAKE_PROFILE
  SPAM
  OFFENSIVE_BEHAVIOR
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED_NO_ACTION
  RESOLVED_WARNING
  RESOLVED_BANNED
  DISMISSED
}

model UserReport {
  id String @id @default(cuid())

  // Reporter (who made the report)
  reporterId String
  reporter   User   @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  // Reported user (who was reported)
  reportedUserId String
  reportedUser   User   @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)

  // Report details
  reason      ReportReason
  description String?

  // Context (optional)
  chatRoomId String?
  messageId  String?

  // Status tracking
  status     ReportStatus @default(PENDING)
  reviewedBy String? // Admin user ID
  reviewedAt DateTime?
  adminNotes String?

  // Resolution
  actionTaken String? // "WARNING", "BAN", "NONE", etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft delete (v3.0)
  deletedAt DateTime?

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@index([reporterId, reportedUserId, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// ANALYTICS TRACKING — Event Definition & Aggregation
// ═══════════════════════════════════════════════════════════════

model AnalyticsEventDef {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "user.registered"
  category    String // "user"|"match"|"chat"|"revenue"|"admin"
  description String   @default("")
  properties  String   @default("{}") // JSON Schema
  isActive    Boolean  @default(true)
  sampleRate  Float    @default(1.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnalyticsDailyAgg {
  id         String   @id @default(cuid())
  date       DateTime // aggregation date
  eventName  String // event name
  metricName String // "count"|"unique_users"|"avg_value"
  value      Float // metric value
  dimensions String   @default("{}") // JSON dimensions
  createdAt  DateTime @default(now())

  @@unique([date, eventName, metricName, dimensions])
  @@index([date])
  @@index([date, eventName])
}

// ═══════════════════════════════════════════════════════════════
// OUTCOME — T08 成果验证、成本归因与订阅
//
// 对齐：AC-15（自报与双方确认**分开**，不把系统猜测计为已验证）
//       AC-16（任务成本 / 人工工时 / 介绍漏斗**可复算**）
//       AC-21（用量可复算；退款/失败/升级/降级状态一致）
//
// 设计约束（继承 tenancy.prisma / connection.prisma 的同一套）：
//   1. **纯新增** —— 本文件不改动既有模型的任何列语义，可独立上线（零停机、零回归）。
//   2. **方言无关** —— 不含任何 `@db.*` 原生类型标注，同一份定义可同时为
//      libSQL（当前生产）与 PostgreSQL（M6 目标）生成；差异只体现在迁移 SQL。
//   3. **软引用优先** —— 成果与验证是**证据**，不应随被引用行级联消失
//      （同 `WorkflowJob.proposalId` 的取向，见 connection.prisma 文件头）。
//   4. **验证级别是派生值，不是入参** —— 见 `src/lib/outcome/verification.ts`。
//      🔴 若允许客户端直接写 `verificationLevel`，AC-15 会在第一次越权调用时失效。
//
// 为什么**不**复用 core.prisma 的 `Subscription` / `Payment`：
//   它们面向**个人 B2C**（`userId` + Stripe），而 T08 是**组织级用量计费**（`organizationId`）。
//   混用会让「这个用户是不是会员」这条既有查询悄悄包含社群订阅 —— 最典型的污染方式。
//   `AnalyticsEvent` 同理不复用：它是"用户做了什么"的行为流，不是"业务产出了什么"的账。
// ═══════════════════════════════════════════════════════════════

/// 成果验证级别（三级，逐级升高）。
/// 🔴 **派生自 `OutcomeVerification` 记录集**，不是可自由设置的字段。
enum OutcomeVerificationLevel {
  SELF_REPORTED // 仅上报方陈述 —— 🔴 **不算验证成功**（AC-15 的字面要求）
  COUNTERPARTY_CONFIRMED // 对手方确认
  EXTERNALLY_VERIFIED // 外部证据核验（运营，`outcome.verify`，仅 ADMIN+）
}

/// 成果记录：一次连接（提案）的最终产出。
///
/// 与 `IntroductionWorkflow` 的关系：提案 1:1 绑定一份成果。
/// `OUTCOME_RECORDED` 是阶段机终态（见 `src/lib/workflow/stage-machine.ts`），
/// 但本表**不**强 FK 到提案 —— 见下 `proposalId` 注释。
model Outcome {
  id String @id @default(cuid())

  /// 租户谓词。**不可省** —— 所有查询都必须以它为首要条件（T01 铁律）。
  organizationId String

  /// 软引用：挂载的提案。**刻意无外键** —— 成果是被删资源的证据，
  /// 删提案不应连带抹掉"这里曾经发生过一次成功的连接"。
  /// `@@unique` 保证一个提案只落一份成果（`OUTCOME_RECORDED` 是终态）。
  proposalId String

  /// 软引用：租户内筛选用（同 `IntroductionWorkflow.missionId`）。
  missionId String

  /// 软引用：上报方。**不进 DTO** —— 返回 userId 等于把"谁跟谁连接了"这条
  /// 关系数据披露给任意 `outcome.read` 持有者（MEMBER 起即有）。DTO 只给角色。
  reporterId String

  /// 软引用：对手方。**不进 DTO**，同上。
  counterpartyId String

  /// 上报方的陈述（自报内容）。这是**原始事实**，不是结论 —— 它本身不能证明成功。
  summary String

  /// 🔴 **派生快照**：只由服务层依 `OutcomeVerification` 记录集写入（`deriveVerificationLevel`），
  /// **不接受客户端入参**。默认 `SELF_REPORTED` 即"下限"：上报即得，但**不是**验证成功。
  verificationLevel OutcomeVerificationLevel @default(SELF_REPORTED)

  /// 成果发生时间（**业务时间**，可回填）。与 `createdAt`（系统看见的时间）刻意分开：
  /// 成本/漏斗按时段复算时，口径必须明确取哪一个。
  occurredAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  verifications OutcomeVerification[]

  /// 一个提案只落一份成果。
  @@unique([proposalId])
  /// 运营视图按"验证级别"分桶（"已验证 / 仅自报"）是主查询。
  @@index([organizationId, verificationLevel])
  @@index([organizationId, createdAt])
  @@index([organizationId, missionId])
}

/// 验证记录：每一次"确认 / 核验"是一条**不可变记录**。
///
/// 事件溯源：级别由**记录集**派生（`deriveVerificationLevel`），不由单条记录决定。
/// 想撤销一次确认，就再记一条相反语义的记录，而不是**改写历史** ——
/// 后者会让"这条成果当时算不算数"永远无法回溯。
model OutcomeVerification {
  id String @id @default(cuid())

  organizationId String
  outcomeId      String

  /// 本条记录把级别抬到哪一档。派生时取**记录集中最高**的一档。
  level OutcomeVerificationLevel

  /// 确认 / 核验人 userId。系统核验为 null。**不进 DTO**。
  actorId String?

  /// 证据摘要（**脱敏后**落库）。**不进 DTO** —— 原文可能含 PII。
  evidence String?

  note      String?
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// 正向：验证记录脱离成果没有意义 → **强 FK + CASCADE**
  /// （与 `IntroductionWorkflow.proposalId` 同取向，与 `Outcome.proposalId` 相反）。
  outcome      Outcome      @relation(fields: [outcomeId], references: [id], onDelete: Cascade)

  /// 幂等：同一人对同一成果的同一级别只算一次确认（重复提交不产生第二条记录）。
  /// ⚠️ `actorId` 可空，而 SQL 唯一索引**不去重 NULL** —— 故系统核验（`actorId=null`）
  /// 的幂等由服务层负责，不依赖此约束。
  @@unique([outcomeId, level, actorId])
  @@index([organizationId, createdAt])
  @@index([outcomeId])
}

// ═══════════════════════════════════════════════════════════════
// TENANCY — T01 身份与多租户底座
//
// 对齐契约：contracts/schema.sql:4-14 (organizations / memberships / persons)
// 与 schema.sql:55-59 (audit_events)。
//
// 设计约束（来自 MIGRATION_PLAN.md §2）：
//   1. 加列优先（Additive-first）—— 本文件**全部为新增模型**，不改动既有 39 个模型
//      的任何列语义，因此可先于任何数据回填独立上线，零停机、零回归。
//   2. `User` ↔ 契约的 `persons` 同义。为避免全站重命名（P1-6 阶段已清理过一轮
//      Legacy 命名），保持 `User` 不动，仅在语义层建立映射。
//   3. 方言无关：本文件不包含任何 `@db.*` 原生类型标注，同一份定义可同时为
//      libSQL（当前生产）与 PostgreSQL（M6 目标）生成；差异只体现在迁移 SQL。
//   4. 绝不信任客户端传入的 organizationId —— 解析逻辑见 src/lib/tenancy/。
// ═══════════════════════════════════════════════════════════════

/// 租户角色。取值与 contracts/schema.sql:12 的 CHECK 约束逐字一致。
enum MembershipRole {
  OWNER // 租户所有者：可转让、可删除租户
  ADMIN // 管理员：可管理成员与全部业务资源
  OPERATOR // 运营：可创建/执行 Mission 与连接，不可管理成员
  MEMBER // 成员：仅可操作自己的 Intent / Consent
}

/// 租户状态。
enum OrganizationStatus {
  ACTIVE
  SUSPENDED // 停用：可读不可写，用于风控与欠费
}

/// 成员状态。
enum MembershipStatus {
  ACTIVE
  INVITED // 已邀请未接受：不产生任何租户内权限
  SUSPENDED // 已停用：保留数据，权限立即失效
}

/// 租户（组织）。对应契约 organizations 表。
model Organization {
  id        String             @id @default(cuid())
  name      String
  /// 对外可读标识，用于 URL 与分享页；唯一。
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  memberships Membership[]
  auditEvents TenantAuditEvent[]

  // ── T02 Connection OS 反向关系（connection.prisma）──
  missions              Mission[]
  missionParticipations MissionParticipation[]
  idempotencyRecords    IdempotencyRecord[]

  // ── T03 Connection OS 反向关系（connection.prisma）──
  socialIntents SocialIntent[]

  // ── T05 Connection OS 反向关系（connection.prisma）──
  //
  // 注意：`ConnectionProposal` 上**同时**有 `missionId` 与 `organizationId` 两个外键，
  // 但只有 `organizationId` 指向本模型，因此不需要额外命名关系。
  connectionProposals ConnectionProposal[]
  proposalDecisions   ProposalDecision[]

  // ── T06 Connection OS 反向关系（connection.prisma）──
  //
  // ⚠️ 注意 `WorkflowJob.proposalId` / `MessageDelivery.recipientId` **不在此列**：
  // 它们是**软引用**（无 FK），见 connection.prisma 文件头「软引用，不是外键」。
  // 只有真正建了 FK relation 的三个模型出现在这里。
  workflowJobs           WorkflowJob[]
  notificationDeliveries NotificationDelivery[]
  introductionWorkflows  IntroductionWorkflow[]

  // ── T08 Connection OS 反向关系（outcome.prisma）──
  //
  // ⚠️ 注意 `Outcome.proposalId` / `.reporterId` / `.counterpartyId` **不在此列**：
  // 它们是**软引用**（无 FK）—— 成果是被删资源的证据。只有 `OutcomeVerification.outcomeId`
  // 建了真 FK（CASCADE）。
  outcomes             Outcome[]
  outcomeVerifications OutcomeVerification[]

  // ── T08 Connection OS 反向关系（billing.prisma）──
  //
  // ⚠️ 注意两表里的 id 列（`UsageRecord.sourceId` / `BillingEvent.chargeId`）
  // **不在此列**：它们是**软引用**（无 FK）—— 账是历史，删提案/删成果不该抹掉用量。
  // 只有 `organizationId` 建了真 FK。
  usageRecords  UsageRecord[]
  billingEvents BillingEvent[]

  // ── T09 Agent Runtime 反向关系（agent.prisma）──
  //
  // ⚠️ 注意 `AgentRun.requestedBy` / `AgentApproval.actorId` **不在此列**：
  // 它们是**软引用**（无 FK）—— 用户注销后"谁批准过什么"仍须可查。
  // `AgentCall` 虽是 `AgentRun` 的子表，但它自己也带 `organizationId` 外键
  // （本仓铁律：每条账都要能独立按租户查询），故这里仍需一条反向关系。
  agentRuns      AgentRun[]
  agentCalls     AgentCall[]
  agentApprovals AgentApproval[]

  @@index([status])
}

/// 成员关系（用户 × 租户）。对应契约 memberships 表。
/// 契约用复合主键 (organization_id, person_id)；Prisma 用代理主键 + 唯一约束表达，
/// 语义等价且便于后续扩展（如软删除、审计字段）。
model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole   @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)

  /// 同一租户内同一用户只能有一条成员关系。
  @@unique([organizationId, userId])
  /// 反查「我属于哪些租户」是每次会话建立时的热路径。
  @@index([userId, status])
  @@index([organizationId, role])
}

/// 租户级审计事件。对应契约 audit_events 表。
///
/// 与既有 `AuditLog`（core.prisma 哈希链审计）**并存**，分工如下：
///   - `AuditLog`      ：既有产品行为的不可抵赖链（保留 prevHash/entryHash），不动。
///   - `TenantAuditEvent`：闭环的**安全事件流**（租户/成员/授权/越权尝试），
///                        可写 `safeMetadata`（脱敏，禁止放 PII 明文）。
/// 收敛计划见 REUSE_MATRIX.md B5（M5 之后）。
model TenantAuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  /// 触发者；系统触发时为 null（例如定时任务、迁移）。
  actorId        String?
  /// 事件类型，命名规范：`<domain>.<action>`，如 `membership.role_changed`。
  eventType      String
  /// 资源类型，如 `membership` / `mission` / `proposal`。
  resourceType   String
  resourceId     String?
  /// 脱敏元数据（JSON 文本）。**禁止**写入密码、令牌、完整邮箱等 PII。
  safeMetadata   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, eventType])
  @@index([resourceType, resourceId])
}
