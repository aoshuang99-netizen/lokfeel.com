// ═══════════════════════════════════════════════════════════════
// AGENT — T09 Agent Runtime（Slice 2：持久化）
//
// 对齐：AC-08（注入不得改变权限 / 泄露资料 / 绕过审批）、AC-20（**每次调用可归因**）
//
// 设计约束（继承 outcome.prisma / billing.prisma 的同一套）：
//   1. **纯新增** —— 本文件不改动既有模型的任何列语义，可独立上线（零停机、零回归）。
//   2. **方言无关** —— 不含任何 `@db.*` 原生类型标注。
//   3. **软引用优先** —— `requestedBy` / `actorId` / `subjectLabel` 都不建 FK：
//      用户注销后，**谁批准过什么**必须仍然可查（审计的意义就在于此）。
//      只有 `organizationId` 与 `AgentCall.runId` / `AgentApproval.runId` 建真 FK。
//
// ── 与 `src/lib/agent/`（Slice 1 纯内核）的关系 ──────────────────────
//   内核**不 import 本文件的任何东西**（它连 Prisma 都不 import —— 见
//   `scripts/check-agent-invariants.mjs` 的 A2）。本文件是**租户服务层**的存储形态，
//   服务层在 `src/lib/agents/`。
//   🔴 目录边界**就是**执法点：`src/lib/agent`（单数）＝无 IO 的内核；
//      `src/lib/agents`（复数）＝允许碰 DB 的服务层。把这两件事混进一个目录，
//      A1/A2 门禁立刻失效，而"内核无 IO"这条保证会**静默**退化成口头约定。
//
// ── 为什么 `AgentRun.status` **是列**（而不是像 `BillingEvent` 那样不落列）──
//   T08 在 billing.prisma 里立过"状态是派生值，不落列"，其判据是：
//   该状态**永远只由事件集派生**、且**不会被下推成 SQL 谓词**。
//   本表不满足该判据的第二条：「待我审批的运行」是一个**必须下推**的查询
//   （`WHERE status IN ('AWAITING_APPROVAL','DEGRADED')`）。
//   不落列就只能"取最近 N 条 → 应用层派生"，那会踩 T07 立下的
//   「派生过滤无法下推 SQL 时的诚实口径」（SCAN_LIMIT）—— 列表页的**总数**会失真。
//   ⇒ 落列，但配两条硬约束把"第二个事实来源"的风险压住：
//     ① `status` **只**经 `src/lib/agents/runs.ts` 的 `transitionRun()` 修改，
//        该函数在执行 UPDATE 前**必须**先过 `approval.ts` 的真相表断言；
//     ② 终态一致性有**可复跑的对账断言**（见 `scripts/connection/migrate.mjs` 的
//        C6 段 + `tests/agents/approval-consistency.test.ts`）：`status='APPROVED'|'REJECTED'`
//        的运行**必须**有一条对应的 `AgentApproval` 行。
//
// ── 为什么 `AgentCall` 是独立表（而不是 AgentRun 上的几个列）──
//   一次运行可以有**多次**模型调用（重试 / 降级路径 / 将来的多步技能），
//   而 AC-20 要求"**每次调用**可归因"。挤进 AgentRun 的列就会把
//   "最后一次调用"当成"这次运行花的钱" —— 重试场景下金额会**静默少算**。
// ═══════════════════════════════════════════════════════════════

/// 运行状态。**必须与 `src/lib/agent/types.ts` 的 `AGENT_RUN_STATUSES` 逐字一致**
/// （有测试守着：`tests/agents/schema-drift.test.ts`）。
///
/// ⚠️ 为什么用 Prisma enum 而不是裸 `String`：既有的 connection.prisma / billing.prisma
/// 都这么做；SQLite 下枚举落为 TEXT，不引入数据库方言差异。
/// 代价是"TS 与 Prisma 两处清单"，因此**必须**有漂移检测 —— 否则新增一个状态时
/// 只在 TS 加了，写入会在运行期才炸。
enum AgentRunStatus {
  PROPOSED
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  EXECUTED
  DEGRADED
  BLOCKED_QUOTA
  FAILED
}

/// 风险级。与 `types.ts` 的 `RISK_LEVELS` 逐字一致。
enum AgentRiskLevel {
  LOW
  MEDIUM
  HIGH
}

/// 模型提供方种类。与 `types.ts` 的 `PROVIDER_KINDS` 逐字一致。
/// 🔴 `RULES` = **根本没调模型**（规则式兜底）—— 把它记进账本，
///    才能使"降级率"可复算，而不是只能靠读日志。
enum AgentProviderKind {
  OPENAI
  STUB
  RULES
}

/// 人工裁决结果。**只有两种终局**：批准 / 驳回。
/// 🔴 这里**没有** `EXECUTED` —— 裁决与执行是两件事（见文件末「执行不在本切片」）。
enum AgentApprovalDecision {
  APPROVED
  REJECTED
}

/// 一次 Agent 运行（提案的持久形态）。
///
/// 🔴 本表**不含**任何主体档案数据：只有 `subjectLabel` 这类**标签**。
///    真实披露要等接线，且必须经 `discloseSubject()` 投影后再进 prompt（AC-03）。
model AgentRun {
  id String @id @default(cuid())

  /// 租户谓词。**不可省** —— 所有查询都以它为首要条件（T01 铁律）。
  organizationId String

  /// 技能键（`INTENT_EXTRACTION` / `INTRO_DRAFT` / `COORDINATION_ADVICE`）。
  skill String

  /// 当前状态。创建时落初值，此后只经 `decideAgentRun()` 修改（见文件头）。
  status AgentRunStatus

  /// 该技能的风险级（快照）。落库理由：以后调整技能风险级，
  /// 历史运行的**当时**风险级不应被追溯修改。
  risk AgentRiskLevel

  /// 是否必须人工批准才能执行（含"因注入信号而升级"的情形）。
  requiresApproval Boolean @default(false)

  /// 发起人（**软引用**，无 FK）：用户注销后"谁批准过什么"仍须可查。
  requestedBy String

  /// 目标的对象标签（**不是档案**）。Slice 2 只存这个，不存任何字段值。
  subjectLabel String?

  /// 用户原始目标文本。属于**不可信输入**，落库仅为可追溯。
  goal String

  /// 经 zod 校验后的结构化产出（JSON 文本）。**这才是可渲染的那一份**。
  /// 契约拒绝时为 null（`rawText` 可能仍在 —— 那是审计用的证据）。
  proposalJson String?

  /// 模型原始文本。**仅供审计/调试，永不进 DTO、永不渲染**。
  /// 留着它的唯一理由：当契约拒绝了产出时，能回答"模型到底说了什么"。
  rawText String?

  /// 面向用户的说明（降级原因 / 注入升级说明 / 失败原因）。
  reason String?

  /// 降级/失败原因码（`DegradeReason`）。成功为 null。
  degradeCode String?

  /// 本次运行最终采用的提供方种类。
  providerKind AgentProviderKind

  /// 注入信号（JSON 数组）。**只作告警/升级审批的旁证**，不是放行判据。
  injectionSignals String?

  /// 本次运行**全部调用**的成本合计（微分）。冗余但刻意：
  /// 列表页/用量页要按运行聚合，逐条 `JOIN AgentCall` 会随历史增长变慢。
  /// ⚠️ 它**可以**与 `AgentCall` 不一致（写入非原子）→ 由 C6 的对账断言与
  /// `tests/agents/*` 的一致性用例守着；不允许出现"没人发现的不一致"。
  costMicroCents Int @default(0)

  /// 幂等键：同一业务动作只产生一次运行。作用域 = `(organizationId, dedupeKey)`。
  dedupeKey String

  /// 产生本次运行的**请求体指纹**。理由同 `BillingEvent.requestHash`：
  /// 唯一约束只能保证"不重复"，保证不了"同一把键没被复用于另一个意图"。
  requestHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calls        AgentCall[]
  approval     AgentApproval?

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, skill])
}

/// 单次模型调用（或规则式兜底）的**归因记录** —— AC-20 的落点。
///
/// 🔴 失败的调用**也记**：否则"失败不花钱"这个假设永远没人验证过。
model AgentCall {
  id String @id @default(cuid())

  /// 租户谓词。**不可省**（虽然是冗余的 —— run 已经带租户；但本仓的铁律是
  /// "每条账都要能独立按租户查询"，冗余换掉一次 JOIN 与一类越权风险）。
  organizationId String

  runId String

  /// 本次运行内的序号（从 1 开始）。`(runId, seq)` 唯一 ⇒ 重放不会插出重复行。
  seq Int

  skill String

  providerKind AgentProviderKind

  risk AgentRiskLevel

  /// 是否为"高成本"调用（AC-20「限额触发时停止高成本任务」的判定对象）。
  highCost Boolean

  /// 调用是否成功。失败也入账。
  ok Boolean

  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  /// 本次调用的成本（**微分**，整数 —— 与 `cost.ts` 同口径：1 分 = 1e6 微分）。
  /// 用整数而非浮点分，是因为浮点累加会让"对账"变成"看运气"。
  microCents Int @default(0)

  /// 调用发生时刻（**由我们写入**）。注意与 `createdAt` 的区别：
  /// 前者是业务时间（测试可注入），后者是行落库时间。
  at DateTime

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          AgentRun     @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([organizationId, at])
  @@index([organizationId, skill])
  @@index([organizationId, highCost])
}

/// 人工裁决（**只增不改**的事件）。
///
/// 与 `AgentRun.status` 的分工：本表回答"**谁在何时批了什么**"（审计），
/// `status` 回答"现在能不能执行"（查询）。两者的不一致由一致性断言守住。
model AgentApproval {
  id String @id @default(cuid())

  organizationId String

  runId String

  decision AgentApprovalDecision

  /// 裁决人（**软引用**，无 FK）。
  actorId String?

  /// 裁决时该人的租户角色（快照）。落库理由同 `AgentRun.risk`：
  /// 以后改了角色能力矩阵，也不该改写历史裁决的**当时**依据。
  deciderRole String

  /// 裁决备注（驳回时尤其重要 —— "为什么不行"是要给人看的）。
  note String?

  decidedAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          AgentRun     @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// 一次运行只允许**一条**终局裁决（不可改判 —— 要推翻就重新发起一次运行）。
  @@unique([runId])
  @@index([organizationId, decidedAt])
  @@index([organizationId, decision])
}

// ── 执行不在本切片（Slice 2 的显式非目标）───────────────────────────
// `AgentRunStatus.EXECUTED` **在 Slice 2 里不可达**：没有任何路由/服务会把它写进去，
// 因为没有注册任何**执行器**（`EXECUTORS` 为空）。
// 这不是遗漏，而是刻意的：执行 = 产生对外可见的副作用（发消息 / 披露资料），
// 那要先有 T05 的披露出口与 T06 的投递出口接线。**宁可不做，也不伪造成功。**
// 断言见 `tests/agents/execution-unreachable.test.ts`。

// ═══════════════════════════════════════════════════════════════
// BILLING — T08 组织级用量计费（Slice 3）
//
// 对齐：AC-21（**使用量可复算**；退款/失败/升级/降级**状态一致**）
//
// 设计约束（继承 outcome.prisma / tenancy.prisma 的同一套）：
//   1. **纯新增** —— 本文件不改动既有模型的任何列语义，可独立上线（零停机、零回归）。
//   2. **方言无关** —— 不含任何 `@db.*` 原生类型标注。
//   3. **软引用优先** —— 账是历史。删掉一个提案/成果，不该抹掉"这个月用了 5 次介绍"。
//   4. 🔴 **不复用 core.prisma 的 `Subscription` / `Payment`** —— 见下。
//   5. 🔴 **状态是派生值，不是可写的列** —— 见下。
//
// ── 为什么不复用 `Subscription` / `Payment` ──────────────────────────
//   它们面向**个人 B2C**（`userId` + Stripe + 会员权益），而本域是**组织级用量计费**
//   （`organizationId` + Creem + 计量单位）。混用有三种污染：
//     ① 语义污染：「这个用户是不是会员」这条既有查询会**悄悄包含社群订阅**；
//     ② 网关污染：`stripeCustomerId` / `stripePriceId` 是 `@unique` 列，混入 Creem
//        数据会迫使写空值，此后无法区分"没订阅"与"非 Stripe 订阅"；
//     ③ 回滚污染：独立域意味着 C5 可整批 `rollback`（逆序 DROP），不触碰既有表。
//
// ── 为什么状态不落列（与 Slice 1 的 `Outcome.verificationLevel` 同取向）──
//   `verificationLevel` 落列是因为它要被 SQL 计数（`WHERE verificationLevel IN (...)`）
//   —— 那是一个**已知会被下推**的查询谓词。本域不同：订阅方案与账单状态只在
//   「读当前状态」时被用到，且**永远由事件集派生**（`deriveSubscriptionState`）。
//   落一个 `status` 列就等于造了第二个事实来源，它迟早与事件集不一致，
//   而且不一致的那一刻没有任何东西会报错。⇒ **不落列**，读时派生。
//
// ── 事件溯源的两条硬约束 ────────────────────────────────────────────
//   ① **只增不改**：想撤销一次确认就再记一条相反语义的事件，绝不 UPDATE 历史。
//      否则"这单当时到底成没成、退没退款"永远无法回溯（AC-21 的全部意义）。
//   ② **非法迁移必须在写入前被拒**：例如 `REFUNDED → SUCCEEDED` 必须失败。
//      判据在纯内核里（`src/lib/billing/subscription.ts`），服务层写入前先过一遍。
// ═══════════════════════════════════════════════════════════════

/// 计费单元。
///
/// 🔴 与 `src/lib/outcome/metrics.ts` 的 `MetricUnit` **刻意同源** ——
/// 用量账与商业指标必须是同一件事的两种视图。若两处各定义一套，
/// "介绍 3 次"会在报表里变成两个数（AC-16 与 AC-21 会同时崩），
/// 而**不会报任何错**。枚举顺序也保持一致，便于对账脚本按下标对齐。
enum UsageUnit {
  PROPOSAL // 发起一次连接提案
  INTRODUCTION // 完成一次介绍（提案进入已介绍）
  OUTCOME // 上报一份成果
  VERIFICATION // 一份成果被核验（**按"已被核验的成果数"计，不是按核验记录条数** —— 幂等重放不该重复计费）
}

/// 订阅方案（组织级）。`FREE` **刻意不在枚举里** —— 见 `EffectivePlan`：
/// "没有订阅"不是一种订阅，用 `null` 表达比用一个假的 `FREE` 行更诚实。
enum BillingPlan {
  STARTER
  GROWTH
  SCALE
}

/// 计费事件类型（事件溯源的**唯一**写入面）。
///
/// 命名规范 `<主语>_<动作>`，与 `TenantAuditEvent.eventType` 同名风格。
enum BillingEventType {
  SUBSCRIPTION_STARTED // 开通（方案由 `plan` 给出）
  PLAN_CHANGED // 升/降级（方案由 `plan` 给出；升还是降**由纯内核按方案序推导**）
  SUBSCRIPTION_CANCELED // 退订（退订后不可再收新款项，除非重新 STARTED）
  CHARGE_CREATED // 一次支付尝试：进入 PENDING（`chargeId` 必填）
  CHARGE_SUCCEEDED // 该次尝试成功
  CHARGE_FAILED // 该次尝试失败（`reason` 必填 —— 失败的**原因**是运营要看的）
  CHARGE_REFUNDED // 对该次成功尝试退款（终态）
}

/// 一笔支付尝试的**网关侧状态**（保存到事件上的快照）。
///
/// 🔴 `CAPTURED` 与 `SUCCEEDED` **必须分开**（与 `NotificationDeliveryStatus` 同一铁律）：
///   前者是"沙箱捕获了要发出去的请求"，后者是"真实网关已受理"。
///   把沙箱写成 SUCCEEDED 就是虚报外部服务已接通
///   （主指令：「没有真实凭据的流程只能标记 MOCKED / BLOCKED，不能标记 PASSED」）。
enum BillingGatewayStatus {
  CAPTURED // 沙箱捕获（无 Creem 凭据）：记录"要发什么"，不冒充已扣款
  SUCCEEDED // 真实网关受理（provider 回执落 `providerRef`）
  FAILED
}

/// 计费事件（**不可变日志**）。当前方案 / 状态 / 每笔款项的生命周期全部由它派生。
model BillingEvent {
  id String @id @default(cuid())

  /// 租户谓词。**不可省** —— 所有查询都以它为首要条件（T01 铁律）。
  organizationId String

  type BillingEventType

  /// 目标方案。`SUBSCRIPTION_STARTED` / `PLAN_CHANGED` 必填，其余为 null。
  plan BillingPlan?

  /// 款项关联 id（**软引用**，无 FK）。同一笔尝试的 CREATED/SUCCEEDED/REFUNDED 共用它。
  /// 由服务层生成；`CHARGE_*` 事件必填。
  chargeId String?

  /// 金额（**分**，整数 —— 避免浮点求和误差，与 `metrics.ts` 的 `unitCostsCents` 同口径）。
  amountCents Int?

  /// 币种（ISO 4217）。
  currency String @default("USD")

  /// 网关回执引用。**不进 DTO**。
  /// 沙箱语义下这里是**构造出来的请求指纹** —— 见 `src/lib/billing/creem.ts`。
  providerRef String?

  /// 本次尝试的网关侧状态快照。沙箱捕获时为 `CAPTURED`。
  gatewayStatus BillingGatewayStatus?

  /// 失败/退订的原因（`CHARGE_FAILED` / `SUBSCRIPTION_CANCELED` 必填 —— 原因是要给人看的）。
  reason String?

  /// 操作人（软引用，**不进 DTO**）：退款/退订这类管理动作要留痕。
  actorId String?

  /// 幂等键：同一业务动作只入账一次。唯一性作用域 = `(organizationId, dedupeKey)`。
  /// ⚠️ 与 `IdempotencyRecord` **刻意并存**：后者作用在 HTTP 层（同键同体 → 回放首次结果），
  /// 本字段作用在**账本层**（即使没有 HTTP 幂等头，账也不会重复）。
  dedupeKey String

  /// 产生本事件的**请求体指纹**（由调用方算好传入）。
  ///
  /// 🔴 为什么账本要自带它：`dedupeKey` 唯一约束只能保证"不重复"，**保证不了**
  /// "同一个键没有被复用于另一个意图"。后者更危险 —— 调用方拿着旧键发新动作，
  /// 若只按唯一约束处理就会**静默返回旧事件**，而调用方以为新动作生效了。
  /// 有了指纹，服务层可以在命中时比对：**相同 → 回放（replayed）**、
  /// **不同 → 409**（与 `src/lib/connection/idempotency.ts` 的语义逐字一致）。
  /// 放在账本里而不是只放在 HTTP 层，是因为脚本/回填也必须受同一保护。
  requestHash String?

  /// 业务发生时间。**由我们写入**（格式统一为 Prisma 的 `...+00:00`），
  /// 因此本域可以做**时段窗口**统计 —— 这正是 `metrics.ts` 口径 2 把时段留到
  /// 本切片的原因：那边的 `introducedAt` 是历史遗留的混格式列，范围比较会静默错算。
  occurredAt DateTime

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, occurredAt])
  @@index([organizationId, type])
  @@index([organizationId, chargeId])
}

/// 用量记录（**只增不改**的账）。
///
/// 与 `src/lib/outcome/metrics.ts` 的关系（两者都对，但回答不同的问题）：
///   - 指标（Slice 2）是**当前状态快照** —— "现在有多少碳案双方同意"；
///   - 用量账（本表）是**历史流水** —— "这个月真实发生了多少次介绍"。
///   二者在"提案被撤销"这类场景下会**故意**不同：撤销不退款，账不动。
///   这正是不能用一条 SQL 从现状反推账单的原因，也是本表存在的理由。
model UsageRecord {
  id String @id @default(cuid())

  /// 租户谓词。**不可省**。
  organizationId String

  unit UsageUnit

  /// 数量。目前恒为 1（一条业务事实 = 一次用量），保留字段是为了将来
  /// "一次介绍覆盖 N 位成员"这类批量单元不必改表。
  quantity Int @default(1)

  /// 业务发生时间。**由我们写入**（统一格式），供审计与排序。
  occurredAt DateTime

  /// 🔴 **计费期次**（`YYYY-MM`，UTC 自然月）。归集与限额都按它分组。
  ///
  /// 为什么不让对账脚本去 `WHERE occurredAt >= ? AND occurredAt < ?`：
  /// 库里的 DateTime 是 TEXT，本项目**已经踩过**"多来源格式混排（`...Z` /
  /// `...+00:00` / 空格分隔）→ 范围比较返回静默错误的计数"（见 `T08/risks.md` R10）。
  /// 即使本表的 `occurredAt` 全由我们自己写、格式一致，把**可复算的数字**押在
  /// "字符串字典序恰好等于时间序"上仍是脆的 —— 换一次写入路径就会破。
  /// 期次是账单本来就有的概念，把它显式落列 ⇒ 对账退化为一次**纯等值比较**，
  /// 与日期格式彻底解耦。
  periodKey String

  /// 来源资源的类型（`proposal` / `introduction` / `outcome` / `verification`）。
  sourceType String

  /// 来源资源 id（**软引用**，无 FK —— 账是历史，见文件头约束 3）。
  sourceId String

  /// 幂等键：同一来源事实只入账一次。唯一性作用域 = `(organizationId, dedupeKey)`。
  /// 约定格式：`<unit-lower>:<sourceId>`（由 `usageDedupeKey()` 统一产出）。
  dedupeKey String

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, periodKey, unit])
  @@index([organizationId, occurredAt])
  @@index([sourceType, sourceId])
}

// ═══════════════════════════════════════════════════════════════
// P0-5 · Bot 可选模块 schema（2026-09-28 从核心 schema 移出）
//
// 本文件与 core.prisma 一起参与 prisma generate（同一 client、同一次生成），
// 因此**业务代码零改动**。它的意义：
//   · 多租户 / 开源核心改造只面对 core.prisma，6 张 Bot 表 + 4 个 Bot 枚举
//     不再进入改造面（原估可减少约 14% 多租户改造量）
//   · 开源发行构建可在打包时排除本文件（配合「默认关闭的可选模块」定位，
//     见 docs/OPEN-CORE-POSITIONING.md §4；届时需同时移除 Bot 代码路径）
//
// 注意：User.isBot / botType / botConfig 是 User 表的列（核心侧），
// 属数据列而非表，本阶段不迁移 —— 迁移它们需要破坏性 DB 变更。
// ═══════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════
// BOT SYSTEM — Digital User Models
// ═══════════════════════════════════════════════════════════════

enum BotType {
  SEED // 种子用户，冷启动用
  SIMULATION // 行为模拟用户
  TRAINING // 训练数据生成
  ACTIVE // 活跃参与匹配
}

enum BotActivityLevel {
  GHOST // 隐身，仅匹配不可见
  LOW // 低活跃度 (10% 在线时间)
  MEDIUM // 中活跃度 (30% 在线时间)
  HIGH // 高活跃度 (60% 在线时间)
  FULL // 全天候在线
}

enum Ethnicity {
  CAUCASIAN
  AFRICAN_AMERICAN
  HISPANIC_LATINO
  ASIAN
  SOUTH_ASIAN
  MIDDLE_EASTERN
  MIXED
  OTHER
}

enum OnlinePattern {
  MORNING // 6AM-12PM
  AFTERNOON // 12PM-6PM
  EVENING // 6PM-12AM
  NIGHT // 12AM-6AM
  RANDOM
  WORK_HOURS // 9AM-5PM
  AFTER_WORK // 5PM-10PM
}

// Bot扩展资料 - 数字用户详细信息
model BotProfile {
  id        String @id @default(cuid())
  // P0-5 拆分说明：与核心 Profile 的关联降级为普通列（DB 侧 FK 保留不变）。
  // 跨文件 Prisma 关系要求 core.prisma 声明反向字段（P1012），会让核心 schema
  // 重新引用 Bot 类型 —— 违背本拆分的目的。查询路径：先按 userId 查 Profile.id，
  // 再按 profileId 查本表（见 src/lib/bot-automation.ts 的 findBotProfileByUserId）。
  profileId String @unique

  // 基础配置
  botType       BotType          @default(SEED)
  activityLevel BotActivityLevel @default(LOW)

  // 人口统计扩展
  ethnicity      Ethnicity?
  occupation     String? // "Software Engineer", "Teacher", etc.
  industry       String? // "Tech", "Healthcare", "Finance", etc.
  educationLevel String? // "High School", "Bachelor's", "Master's", "PhD"
  incomeRange    String? // "$30k-50k", "$50k-100k", etc.

  // 兴趣与偏好 (JSON arrays - SQLite compatible)
  interests   String @default("[]") // JSON: ["hiking", "cooking", "photography"]
  hobbies     String @default("[]") // JSON: ["gaming", "yoga", "reading"]
  musicGenres String @default("[]") // JSON: ["rock", "jazz", "electronic"]
  movieGenres String @default("[]") // JSON: ["thriller", "romance", "sci-fi"]

  // 行为模拟配置
  onlinePattern   OnlinePattern @default(EVENING)
  avgResponseTime Int           @default(30) // 平均响应时间（分钟）
  maxDailyMatches Int           @default(3) // 每日最大匹配数

  // 行为概率配置（JSON）
  behaviorConfig String?

  // 匹配偏好（扩展 Profile 的 preferred* 字段）(JSON arrays)
  preferredEthnicities String @default("[]") // JSON: Ethnicity[]
  preferredOccupations String @default("[]") // JSON: string[]
  preferredEducation   String @default("[]") // JSON: string[]

  // 学习状态
  totalInteractions  Int   @default(0)
  successfulMatches  Int   @default(0)
  avgEngagementScore Float @default(0) // 0-100

  // 学习数据（JSON）
  learningData String?

  // 头像配置
  avatarStyle  String? // "professional", "casual", "artistic"
  avatarSource String? // "generated", "stock", "ai_avatar"

  // 状态
  isActive     Boolean   @default(true)
  lastActiveAt DateTime?
  sleepUntil   DateTime? // 暂停到指定时间

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([botType])
  @@index([activityLevel])
  @@index([isActive])
}

// Bot行为交互日志
model BotInteractionLog {
  id           String  @id @default(cuid())
  botUserId    String
  targetUserId String?
  matchId      String?

  // 交互类型
  interactionType String // "match_received", "match_reacted", "message_sent", "message_received", "profile_viewed"

  // 行为详情
  action        String // "accept", "pass", "respond", "initiate"
  responseDelay Int? // 响应延迟（秒）

  // 结果
  outcome         String? // "success", "rejected", "no_response", "blocked"
  engagementScore Int? // 0-100 参与度评分

  // 上下文
  context String? // JSON: {matchScore, matchReason, etc.}

  createdAt DateTime @default(now())

  @@index([botUserId, createdAt])
  @@index([interactionType])
  @@index([outcome])
}

// Bot学习批次
model BotLearningBatch {
  id String @id @default(cuid())

  // 批次信息
  batchNumber Int
  status      String @default("pending") // pending, running, completed, failed

  // 数据范围
  startDate DateTime
  endDate   DateTime

  // 统计数据
  totalInteractions Int   @default(0)
  avgEngagement     Float @default(0)
  successRate       Float @default(0)

  // 更新的偏好配置
  preferenceUpdates String? // JSON array of changes

  // 执行日志
  executionLog String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([batchNumber])
}

// Bot学习记录 - 实时交互数据
model BotLearningRecord {
  id     String @id @default(cuid())
  botId  String
  userId String // 交互对象用户ID

  // 交互类型
  interactionType String // MATCH_REQUEST, MATCH_ACCEPT, CHAT_MESSAGE, etc.
  outcome         String // POSITIVE, NEUTRAL, NEGATIVE

  // 上下文数据
  context String? // JSON string (SQLite compatible)

  // 处理状态
  processed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([botId])
  @@index([processed])
  @@index([createdAt])
  @@index([interactionType])
}

// Bot偏好向量 - 学习结果
model BotPreference {
  id    String @id @default(cuid())
  botId String @unique

  // 五维偏好 (0-1)
  relationshipStructure Float @default(0.5)
  communicationStyle    Float @default(0.5)
  interests             Float @default(0.5)
  values                Float @default(0.5)
  lifestyle             Float @default(0.5)

  // 元数据
  confidence Float @default(0.1) // 置信度 (0-1)
  sampleSize Int   @default(0) // 样本数量

  createdAt   DateTime @default(now())
  lastUpdated DateTime @updatedAt

  @@index([botId])
}

// Bot头像管理
model BotAvatar {
  id           String  @id @default(cuid())
  botId        String  @unique
  originalUrl  String?
  processedUrl String? // 处理后（压缩、优化）的URL

  style     String // 原始风格
  ethnicity String // 原始种族标签

  status   String @default("pending") // pending, active, failed, retired
  useCount Int    @default(0) // 使用次数

  generatedAt DateTime  @default(now())
  lastUsedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// CONNECTION OS — 业务闭环实体（自 T02 起逐任务追加）
//
// 对齐契约：
//   - contracts/schema.sql:15-20   (missions)
//   - contracts/connection.openapi.yaml  /missions 与 /v1/missions/{missionId}
//
// 设计约束（继承 T01 的 tenancy.prisma，见 docs/implementation/T01/DIALECT-DIFF.md）：
//   1. **方言无关**：本文件不出现任何 `@db.*` 原生类型标注。同一份定义可同时为
//      libSQL（当前生产）与 PostgreSQL（M6 目标）生成；差异只体现在迁移 SQL。
//   2. **复合语义字段走 `String` + 单点 codec**：libSQL 无 `jsonb`，契约里的
//      `jsonb` 一律落为 JSON 文本，编解码**只允许**经 `src/lib/connection/json-codec.ts`。
//      散落的 `JSON.parse` 会导致「有的存字符串、有的存对象」的静默腐化。
//   3. **`organizationId` 一律由服务端从会话派生**（`resolveTenant()`），
//      绝不接受客户端传入值作为授权依据。
//   4. **加列优先 / 只增不改**：新任务只往本文件加模型；改动既有列语义需走 MIGRATION_PLAN。
// ═══════════════════════════════════════════════════════════════

/// Mission 生命周期。契约 missions.status 为自由 text（默认 'draft'），
/// 这里收敛为枚举 —— 取值与 `src/lib/connection/missions.ts` 的状态机逐字一致。
enum MissionStatus {
  DRAFT // 草稿：不可分享，分享链接返回 404
  ACTIVE // 已发布：分享页可访问，可被加入
  PAUSED // 已暂停：分享页只读，拒绝新加入（保留历史）
  CLOSED // 已关闭：分享页只读，终止
}

/// 成员加入 Mission 的状态。
/// ⚠️ 与 T03 的 `SocialIntent` 分工：本模型只表达「谁加入了哪个任务」（粗粒度、必填），
/// `SocialIntent` 表达「该成员的 need/offer/逐字段披露范围」（细粒度，T03 交付）。
/// 二者是 1:1 互补关系，不是重复建模。
enum MissionParticipationStatus {
  INTERESTED // 已加入/表达参与意愿
  WITHDRAWN // 本人撤销
  REMOVED // 运营移出
}

/// 连接任务。对应契约 missions 表。
model Mission {
  id             String @id @default(cuid())
  /// 租户归属。**必填**（T01 起新表直接带上，不再走加列批次）。
  organizationId String
  /// 任务发起人。契约 persons 同义于本仓 `User`。
  ownerId        String

  title           String
  goal            String
  offer           String
  /// 约束（JSON 文本，字符串数组）。**必须**经 json-codec 读写。
  constraints     String?
  /// 成功标准：验收「连接是否达成」的判据（PRD 要求可判定，非口号）。
  successCriteria String

  status MissionStatus @default(DRAFT)

  /// 分享令牌：`/m/<shareToken>` 的唯一寻址方式。
  /// 高熵、不可枚举、URL-safe；**即能力凭证**，故不可预测、不可自增。
  shareToken    String  @unique
  /// 是否允许**未注册**访客预览（最小披露）。关闭后分享页一律要求登录。
  publicPreview Boolean @default(true)

  /// 限额。null = 不限。
  maxParticipants Int?

  expiresAt   DateTime? // 截止（过期后分享页只读、拒绝新加入）
  publishedAt DateTime? // 首次 publish 时间
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User                   @relation("UserMissions", fields: [ownerId], references: [id], onDelete: Cascade)
  participations MissionParticipation[]
  socialIntents  SocialIntent[]
  proposals      ConnectionProposal[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════════
// T03 · SocialIntent —— 成员意图与**逐字段披露**
//
// 与 MissionParticipation 的分工（不是重复建模）：
//   - MissionParticipation：粗粒度「谁加入了哪个任务」（T02，必填、可计数）
//   - SocialIntent：       细粒度「该成员的 need/offer/约束/有效期 + 逐字段可见范围」（T03）
//   二者 1:1 互补；意图必须挂在一条已加入的参与关系之下（父锚点 `missionId + userId`）。
//
// 安全取向（AC-03 是 BLOCKER）：**默认拒绝**。`disclosure` 里没写的字段一律按
// field-catalog 的 defaultAudience 处理，而目录中每个字段的默认值都是 `SELF`
// （即不披露）。「用户没选」**绝不**等价于「用户同意」。
// ═══════════════════════════════════════════════════════════════

/// 意图生命周期。**只有本人能改**；`WITHDRAWN` 是终态（重新参与须显式 reactivate）。
///
/// 「已过期」**刻意不落库**：它由 `expiresAt` 与当前时间**派生**
/// （见 `intents.ts` 的 `deriveIntentStatus()`）。若把它做成存储状态，
/// 就必须依赖定时任务翻状态 —— 定时任务一旦停摆，「过期」会静默失效，
/// 而已过期意图仍在被披露。派生状态没有这个失败模式。
enum IntentStatus {
  ACTIVE // 生效中：可被披露、可进入匹配
  WITHDRAWN // 本人撤销：不再披露，且不可编辑（须 reactivate 显式复活）
}

/// 逐字段披露的受众档位。**档位是包含式的**（档位越高 = 允许看到的人越多）：
///   SELF          → 仅本人（= 不披露）
///   ORGANIZER     → 本人 + 组织者
///   COUNTERPARTY  → 本人 + 组织者 + **已双向同意**的对手方（T05 起）
///   CANDIDATE     → 本人 + 组织者 + 同任务的互补伙伴（T04 起；最宽）
/// 因此"某受众能否看到" = `rank(granted) >= rank(viewer)`。
///
/// ⚠️ 为什么 `CANDIDATE` 排在 `COUNTERPARTY` **之后**（而不是"候选比对手方窄"）：
///   记 `C` = 已同意的对手方集合，`P` = 同任务的互补伙伴集合。**`C ⊆ P`** ——
///   任何已同意的对手方，在同意之前本来就是一名候选伙伴。于是
///   `{组织者}+C ⊆ {组织者}+P`，即"给已同意者看" ⊂ "给伙伴看"。
///   `CANDIDATE` 因此是**更宽**的一档，必须追加在末尾。
///   若误以为"候选更窄"而把它插在 `COUNTERPARTY` 之前，就会出现
///   `rank(COUNTERPARTY) >= rank(CANDIDATE)` → **尚未同意的人看到了用户
///   只授权给已同意对手方的字段** —— 一次静默的越权披露。
///
/// ⚠️ 新增档位时**不得改变已存在档位的相对次序**：库里存的是档位**名字**，
///   理解名字的是本次序；次序一变，历史数据的可见性会静默漂移，
///   且没有任何迁移能"顺便修好"它。（`CANDIDATE` 追加在末尾即满足此约束。）
///
/// 用 `///` 是为了让这条规则进入生成的 Client 类型提示，避免调用方凭直觉猜方向。
enum DisclosureAudience {
  SELF // 仅本人可见（= 不披露）
  ORGANIZER // 任务组织者 / 运营
  COUNTERPARTY // 双向同意后的对手方（T05 起生效）
  CANDIDATE // 同任务的互补伙伴（尚未同意；T04 起生效，最宽）
}

/// 成员意图。对应契约 social_intents 表的语义（契约挂在 organization 上，
/// 本仓显式挂到 Mission —— 意图脱离具体任务没有业务含义，且 mission 级才能做名额/披露判定）。
model SocialIntent {
  id             String @id @default(cuid())
  organizationId String
  /// 父锚点：T02 的 Mission。任务删除时意图级联删除。
  missionId      String
  /// 提交者。**必须**是该 Mission 所属租户的 ACTIVE 成员（服务端回查 memberships）。
  userId         String

  /// 我需要什么（Mission 的 goal 是"发起方要什么"，这里是"协作者要什么"）。
  need        String
  /// 我能提供什么。
  offer       String
  /// 附加约束（JSON 文本，字符串数组）。**必须**经 json-codec 读写。
  constraints String?

  /// 逐字段披露表（JSON 文本）：`{ "<fieldKey>": "SELF"|"ORGANIZER"|"CANDIDATE"|"COUNTERPARTY" }`。
  ///
  /// 语义：**缺失的键 = 未授权**（落到目录默认值 SELF），不在这里补默认值 ——
  /// 「写库时补默认」会把"用户没选"悄悄固化成"系统认为他同意了"。
  disclosure String?

  status IntentStatus @default(ACTIVE)

  /// 有效期。null = 不过期。过期后**仍可编辑续期**，但不再被披露（派生为 EXPIRED）。
  expiresAt   DateTime?
  withdrawnAt DateTime?

  /// ── 导入许可留痕（AC-12「用户主动授权」的落点）──
  /// 用户显式同意「从账户档案导入字段」的**时间戳**。null = 从未同意，
  /// 此时任何 `importFromProfile` 请求都必须被拒（400），不得默认放行。
  importConsentAt DateTime?
  /// 实际从档案导入的字段名（JSON 文本数组）。与 `disclosure` **分开存储**：
  /// 一个记"数据从哪来"、一个记"给谁看"。混在一起会导致"撤回导入"误删披露设置。
  importedFields  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mission      Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user         User         @relation("UserSocialIntents", fields: [userId], references: [id], onDelete: Cascade)

  /// 同一任务同一成员只有一条意图 —— 幂等提交/编辑的落点。
  @@unique([missionId, userId])
  @@index([organizationId, status])
  @@index([organizationId, missionId])
  @@index([userId, status])
  @@index([expiresAt])
}

/// 成员 × Mission 的加入关系。契约中没有独立表（契约把 memberships 与
/// social_intents 直接挂 organization），这里显式建模是为了：
///   1. 让「加入」可计数、可撤销、可审计（AC-11 的加入动作需要落库）；
///   2. 给 T03 的 `SocialIntent` 一个稳定的父锚点（`missionId` + `userId`）。
model MissionParticipation {
  id             String                     @id @default(cuid())
  organizationId String
  missionId      String
  userId         String
  status         MissionParticipationStatus @default(INTERESTED)
  /// 加入时的可选留言（最小披露：不进入公开投影）。
  note           String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mission      Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user         User         @relation("UserMissionParticipations", fields: [userId], references: [id], onDelete: Cascade)

  /// 同一任务同一成员只能有一条加入记录（幂等 join 的落点）。
  @@unique([missionId, userId])
  @@index([organizationId, status])
  @@index([userId, status])
}

/// 幂等记录。契约对 `POST /missions` 强制要求 `Idempotency-Key` 请求头
/// （connection.openapi.yaml:12-19）。同样的键重复提交必须返回**首次结果**，
/// 不得创建第二条 Mission —— 这是 AC-07（幂等）在本任务的最小落点。
///
/// 键空间是 `(organizationId, scope, key)`：同一把 key 在不同租户/不同业务动作下
/// 互不干扰，避免跨租户串号。
model IdempotencyRecord {
  id             String   @id @default(cuid())
  organizationId String
  /// 业务动作，如 `mission.create` / `mission.join`。
  scope          String
  /// 客户端提交的 Idempotency-Key 原文。
  key            String
  /// 请求体指纹（sha256）。同一 key 配不同请求体 → 409（防止「键复用了但意图变了」）。
  requestHash    String
  resourceType   String
  resourceId     String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, key])
  @@index([organizationId, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// T05 · 双边同意（Consent & Trust）—— AC-04 / AC-05 / AC-06
//
// 契约对应：
//   - contracts/schema.sql:693-704   (connection_proposals / proposal_decisions)
//   - contracts/connection.openapi.yaml   POST /connections/proposals、
//     POST /connections/{connectionId}/consent、POST /connections/{connectionId}/revoke
//
// ⚠️ **为什么不复用 core.prisma 的 `ConsentRequest` / `ConsentGrant`**
//   （卡片写"可复用"，此处是逐条核对后的判定，不是偷懒新造表）：
//   那两个模型是 **IM 媒体访问权限** —— `consentType: MEDIA`、
//   `requestedLevel/grantedLevel: L0_TEXT | …`、外键 `conversationId` 挂在**会话**上，
//   语义是"允许对方看我的摄像头 / 麦克风 / 加密消息"。
//   本任务要表达的是"**组织者牵线，与另一个人建立连接**"：没有会话、没有媒体档位、
//   参与者是「提案双方」而非「会话双方」。
//   硬塞进 `ConsentRequest` 需要把 `conversationId` 改成可空、并给 `consentType`
//   加一个与 `MEDIA` 并列的取值 —— 结果是**两个语义域共用一张表**：
//   媒体权限的查询会捞到连接提案，反之亦然（且没有任何编译期信号）。
//   契约本身把二者分表（`consent_grants` vs `connection_proposals`），本仓遵循契约。
//   可以复用的是**模式**而非表：拒绝即关闭、撤销清空待发、执行前再校验。
// ═══════════════════════════════════════════════════════════════

/// 连接提案的生命周期。
///
/// ⚠️ 与 T03 `IntentStatus` 的根本差别：这是**双人**状态机。
///   单人同意**不改变**"待决"这一事实 —— `CONSENT_PENDING` 会跨越第一次 accept。
///   因此"能否介绍"的判据**不是** "有人同意了"，而是 `MUTUALLY_ACCEPTED`
///   （AC-04：单方接受不得发送正式介绍）。
enum ConnectionProposalStatus {
  CONSENT_PENDING // 待决：至少一方尚未表态（刚创建时即此态）
  MUTUALLY_ACCEPTED // 双方均已接受 —— **"可介绍"的唯一状态**
  REJECTED // 任一方拒绝：终态，之后任何表态一律 409
  REVOKED // 任一方撤销：终态；也可从 MUTUALLY_ACCEPTED 撤销（AC-05）
}

/// 个体表态类型。对应契约 `proposal_decisions.decision CHECK IN ('accept','reject','revoke')`。
enum ProposalDecisionKind {
  ACCEPT
  REJECT
  REVOKE
}

/// 连接提案。对应契约 `connection_proposals` 表。
model ConnectionProposal {
  id             String @id @default(cuid())
  organizationId String
  /// 提案依附的 Mission —— 互补关系是在某条任务下被发现并牵线的。
  missionId      String

  /// 发起方。**必须**是同租户 ACTIVE 成员且具备 `proposal.create`（T01 定为 OPERATOR+）。
  proposerId  String
  /// 被介绍方。**必须**是同租户 ACTIVE 成员，且与发起方不是同一人（契约 CHECK 的等价约束）。
  candidateId String

  status ConnectionProposalStatus @default(CONSENT_PENDING)

  /// 发起理由。**会展示给被介绍方** —— 这是对方决定"要不要同意"的唯一依据，
  /// 故必填（契约 `rationale text NOT NULL`）。不得写入内部判断或他人隐私。
  rationale String

  /// 提案有效期。null = 不过期。
  /// ⚠️ AC-06：**执行（介绍）时必须再校验一次本字段**，不能只在创建时校验 ——
  /// 提案完全可能在"双方都同意"与"真正介绍"之间失效。
  expiresAt DateTime?

  /// 介绍落地时间。null = 尚未介绍。写入即代表"连接已建立"，T06 据此驱动后续工作流。
  introducedAt DateTime?
  /// 关闭时间（进入 REJECTED / REVOKED 时写入），用于审计与"提案存活时长"统计。
  closedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mission              Mission               @relation(fields: [missionId], references: [id], onDelete: Cascade)
  proposer             User                  @relation("ProposalProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  candidate            User                  @relation("ProposalCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  decisions            ProposalDecision[]
  /// T06：一提案至多一条介绍工作流（1:1）。提案删除时工作流级联删除。
  introductionWorkflow IntroductionWorkflow?

  /// 同一对（发起方 → 被介绍方）在同一任务下**只能有一条提案**。
  /// 这同时是"重复发起"的最后一道兜底：即便客户端换了 `Idempotency-Key`，
  /// 也不会为同一对搭档堆出多条并行同意流程 —— 那会把"双方同意"退化成
  /// "同意其中一条"，而另外几条仍在待决（用户看到的界面会自相矛盾）。
  @@unique([missionId, proposerId, candidateId])
  @@index([organizationId, status])
  @@index([organizationId, missionId])
  @@index([proposerId, status])
  @@index([candidateId, status])
  @@index([expiresAt])
}

/// 个体表态记录。契约 `PRIMARY KEY(proposal_id, person_id)` —— 每人每提案**至多一行**。
///
/// 语义：这是「**当前**表态」，不是「表态流水」。同一人先 accept 后 revoke 时，
/// 本行被**覆盖**（AC-05 的撤销即由此实现），而不是追加一行 ——
/// 保留流水会把"谁在什么时候改过主意"变成永久记录，那不是本任务要收集的数据。
/// 需要不可抵赖的追加式记录请走 `TenantAuditEvent`（写入失败不影响业务）。
model ProposalDecision {
  id             String @id @default(cuid())
  organizationId String
  proposalId     String
  /// 表态人。服务层**必须**校验其 ∈ {proposerId, candidateId}（非参与者 → 403，不得 404 —— 
  /// 提案对非参与者而言是"存在但不关你的事"，与跨租户的"不存在"是两种不同的答复）。
  personId       String

  decision  ProposalDecisionKind
  /// 可选说明。**不返回给对侧** —— 否则"拒绝理由"就成了一次计划外的信息披露。
  note      String?
  decidedAt DateTime             @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal     ConnectionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  person       User               @relation("UserProposalDecisions", fields: [personId], references: [id], onDelete: Cascade)

  @@unique([proposalId, personId])
  @@index([organizationId])
  @@index([personId, decidedAt])
  @@index([decision])
}

// ═══════════════════════════════════════════════════════════════
// T06 · Workflow Execution — 可靠投递与跟进状态机
//
// 对齐验收：AC-07（幂等）/ AC-09（消息合规）/ AC-14（介绍工作流）/ AC-17（工作流恢复）
//
// 引擎选型（BACKLOG §6-⑤ 的拍板结果）：**DB outbox**，不引入 Temporal。理由：
//   1. 现网部署是 Netlify **免费计划** —— 无常驻进程，跑不了 Temporal worker；
//   2. 现网 DB 是 libSQL，而 Temporal 需要 PG/MySQL —— 引入它等于先做尚未拍板的 M6；
//   3. 本仓已有 `cron-runner` 调度器（netlify/functions）+ 内部 cron 端点（CRON_SECRET 守卫）
//      + T02 幂等层 + T05 的 CAS 范式 —— outbox 是**零新增基础设施**的路线；
//   4. PRD 明确「早期一个可靠的数据库任务队列就足够」，架构文档把 Temporal 定为
//      「工作流复杂度确有必要时引入」。**替换点**已隔离在 `src/lib/workflow/runtime.ts`
//      的驱动接口上，届时只需换驱动器，不改业务侧调用点。
//
// ⚠️ **软引用，不是外键**（刻意）：`WorkflowJob.proposalId` / `missionId` 与
//   `NotificationDelivery.recipientId` 都不建 FK relation，只存 id 字符串。
//   理由：outbox 与投递记录是**已发生事实的留痕**，其存在不能取决于被引用行是否还在。
//   若建 FK 级联，「删掉提案」会连带抹掉「我们曾尝试投递、失败了几次、最终怎么收场」——
//   那正是 AC-17（故障注入后可观测、可接管）最需要的那份证据。
//   这与 `TenantAuditEvent.resourceId` 的取向一致（同样是软引用）。
// ═══════════════════════════════════════════════════════════════

/// 工作流任务类型。每个类型对应一处「业务动作之后的副作用」。
enum WorkflowJobKind {
  PROPOSAL_CREATED // 提案创建 → 通知被介绍方（消解 T05 R4「没人被通知」）
  CONSENT_ACCEPTED // 一方表态 → 通知另一方（含"已同意，等待对方"的阶段性提示）
  INTRODUCE_CONNECTION // 双方同意 → 执行介绍（**投递钩子**：原样调用 introduceConnection()）
  COORDINATION_FOLLOWUP // 介绍落地 → 跟进提示（AC-14 的"跟进"段）
}

/// 任务状态机。
///
/// ⚠️ `DEAD` 与 `TAKEN_OVER` **不是同一件事**，不要合并：
///   - `DEAD`：自动重试已耗尽 → 需要人判断"是否还该送"。系统已放弃。
///   - `TAKEN_OVER`：人**主动**接管（可能发生在 DEAD 之后，也可能在重试中途）。
///     接管后**自动重试必须停止** —— 否则人的处置会被自动重试覆盖。
enum WorkflowJobStatus {
  PENDING // 待执行（`nextAttemptAt` 到点前不可领）
  RUNNING // 已被领取（持租约；租约过期 = 上一个执行者崩了，可被重新领取）
  SUCCEEDED // 执行成功（终态）
  FAILED // 不可重试的终态失败（如校验不通过：重试一万次也一样）
  DEAD // 死信：可重试但重试次数耗尽（终态，等待人工）
  TAKEN_OVER // 人工接管（终态；不再自动重试）
  CANCELLED // 被上游撤销取消（AC-05「撤销取消待发任务」的落点）
}

/// 投递渠道。**仅这两条** —— 主指令要求"仅用官方授权渠道，禁止绕过平台 API"。
enum NotificationChannel {
  IN_APP // 站内通知（写 Notification 表，真实落库）
  EMAIL // 邮件（统一出口；无真实凭据时进沙箱捕获，**不伪造已发送**）
}

/// 投递结果。
///
/// ⚠️ `CAPTURED` 与 `SENT` **必须分开**：前者是"沙箱捕获了投递意图与内容"，
///   后者是"真实外部服务已受理"。把沙箱写成 SENT 就是虚报外部服务已接通
///   （主指令：「没有真实凭据的流程只能标记 MOCKED / BLOCKED，不能标记 PASSED」）。
enum NotificationDeliveryStatus {
  PENDING
  SENT // 真实渠道已受理（provider 回执 id 落库）
  CAPTURED // 沙箱捕获（无凭据）：记录内容与边界，供断言，不冒充已送达
  FAILED
}

/// 介绍工作流的阶段（AC-14 的端到端链路）。
///
/// 与 `ConnectionProposalStatus` 的关系：后者是**授权**状态机（谁同意了），
/// 本枚举是**流程**状态机（事情走到哪一步了）。二者不合并 —— 一次授权可能
/// 对应多次流程推进（如介绍后协调、完成、记成果），而授权在介绍落地后就冻结了。
enum WorkflowStage {
  PROPOSED // 提案已创建，等待表态
  CONSENT_PENDING // 至少一方已表态但未双方同意
  INTRODUCED // 介绍已落地（introducedAt 已写）
  COORDINATING // 双方正在协调（跟进中）
  ACTION_COMPLETED // 连接行动已完成
  OUTCOME_RECORDED // 成果已记录（T08 接手后的终态）
}

/// Outbox / 任务队列。**一张表同时承载待执行、重试、死信、接管** ——
/// 拆成多表会让"一个任务的一生"跨三张表，而 AC-17 要求能一眼看清它的处境。
model WorkflowJob {
  id             String @id @default(cuid())
  organizationId String

  /// **幂等键**（AC-07 的落点）：同一业务动作重复入队只会有一行。
  /// 例：`introduce:<proposalId>`、`proposal-created:<proposalId>`。
  /// 唯一约束 `(organizationId, dedupeKey)` 让并发入队退化为"第二次撞唯一键"，
  /// 而不是"两条任务各投递一次"。
  dedupeKey String

  kind   WorkflowJobKind
  status WorkflowJobStatus @default(PENDING)

  /// 软引用（见文件头说明）：不建 FK，删提案不抹掉投递痕迹。
  proposalId String?
  missionId  String?

  /// 载荷（JSON 文本，经 json-codec 读写）。
  /// ⚠️ **禁止**放 rationale 全文与对侧档案字段 —— 任务是内部调度凭据，
  /// 不是信息披露通道。披露只能经 `discloseSubject()`（T03 的唯一出口）。
  payload String?

  // ── 重试与退避 ──
  attempts      Int      @default(0)
  maxAttempts   Int      @default(5)
  /// 下次可被领取的时间。退避 = 指数 + 抖动（见 `src/lib/workflow/backoff.ts`）。
  nextAttemptAt DateTime @default(now())

  // ── 租约（AC-17 崩溃恢复的落点）──
  /// 领取者标识（worker 实例名）。租约到期后他人可重新领取。
  lockedBy    String?
  lockedUntil DateTime?

  /// 最后一次失败原因（截断存储，仅供排障。**禁止**写入正文内容）。
  lastError String?

  /// 进入死信的时间。
  deadLetteredAt DateTime?
  /// 人工接管者与时间。接管后自动重试停止。
  takenOverBy    String?
  takenOverAt    DateTime?
  /// 被上游取消的时间（AC-05：撤销要能取消待发任务）。
  cancelledAt    DateTime?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// **AC-07 的硬保证**：同一租户内同一业务动作至多一行任务。
  @@unique([organizationId, dedupeKey])
  /// 领取与扫描的主索引：`(status, nextAttemptAt)` 先过滤再排序。
  @@index([status, nextAttemptAt])
  /// 租户内的运营视图（"本社群卡住的任务"）。
  @@index([organizationId, status, nextAttemptAt])
  @@index([organizationId, proposalId])
}

/// 消息投递记录（**审计面**：到底给谁、发了什么、走的哪个渠道、结果如何）。
///
/// 与 `Notification`（core.prisma，站内信的**收件箱**）分工：
///   - `Notification`   → 用户能看到的那条消息（可能被已读/删除）。
///   - `NotificationDelivery` → 我们**投递过**这件事的记录（不可被用户删除，是 AC-09 的证据）。
/// 二者不是重复建模：一条投递可能因为去重而**不**产生新 `Notification`，
/// 也可能在 `Notification` 被删后仍需保留投递证据。
model NotificationDelivery {
  id             String @id @default(cuid())
  organizationId String

  /// 幂等键：`<kind>:<proposalId>:<recipientId>` —— 同一业务动作对同一人只投递一次。
  dedupeKey String

  channel NotificationChannel
  status  NotificationDeliveryStatus @default(PENDING)

  /// 软引用（见文件头说明）：收件人注销后投递记录仍需留存。
  recipientId String

  /// 模板标识（如 `proposal.pending`）。决定文案骨架，与人无关，故可安全落库。
  template  String
  subject   String?
  /// 渲染后的正文。**系统生成**，只含最小披露信息。
  body      String
  actionUrl String?

  /// ── 沙箱捕获（AC-09 的证据面）──
  /// 无真实凭据时不外发，但把"要发什么"记下来：`CAPTURED` + 本字段非空。
  capturedAt        DateTime?
  /// 实际渠道：`in-app` / `resend` / `smtp` / `sandbox`。
  provider          String?
  providerMessageId String?
  failureReason     String?

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, recipientId, createdAt])
  @@index([organizationId, status])
}

/// 介绍工作流实例（**一提案一条**）。记录 AC-14 那条链走到哪一步、每一步何时发生。
model IntroductionWorkflow {
  id             String @id @default(cuid())
  organizationId String
  /// 1:1 绑定提案。强 FK：提案没了，这条流程也就没有意义了。
  proposalId     String @unique
  /// 软引用：missionId 只用于租户内筛选。
  missionId      String

  stage          WorkflowStage @default(PROPOSED)
  /// 进入当前阶段的时间（**超时判定的基准**；AC-17 的"超时"落点）。
  stageEnteredAt DateTime      @default(now())

  /// 阶段时间线（JSON 文本数组）：`[{stage, at, by, reason}]`，追加式。
  /// 与 `ProposalDecision` 相反，这里**刻意留流水** —— 流程推进需要可复盘。
  timeline String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal     ConnectionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([organizationId, stage])
  @@index([organizationId, missionId])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated"
}

datasource db {
  provider = "sqlite"
}

// ═══════════════════════════════════════════════════════════════
// AUTH — NextAuth v5 compatible models
// ═══════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Auth
  password     String?
  role         UserRole  @default(USER)
  tokenVersion Int       @default(0) // bumped on password change/reset to invalidate all previously-issued JWT sessions
  accounts     Account[]
  sessions     Session[]

  // Bot/Digital User Flags
  isBot     Boolean @default(false) // 标记是否为数字用户
  botType   String? // "simulation" | "training" | "seed"
  botConfig String? // 数字用户行为配置（JSON字符串存储）

  // Email Verification
  verificationTokens VerificationToken[] @relation("UserVerificationTokens")

  // Profile
  profile Profile?

  // Matching
  sentMatches     Match[]         @relation("SentMatches")
  receivedMatches Match[]         @relation("ReceivedMatches")
  matchReactions  MatchReaction[]

  // Chat
  // P1-6 阶段 5：原 `chatRooms ChatRoomMember[]` / `messages Message[]` 关系
  // 随 Legacy 三表删除而移除。

  // IM Module
  conversationsA      Conversation[]            @relation("ConversationUserA")
  conversationsB      Conversation[]            @relation("ConversationUserB")
  imMessages          IMMessage[]               @relation("IMMessageSender")
  messageReceipts     MessageReceipt[]
  messageReactions    MessageReaction[]
  imParticipants      ConversationParticipant[]
  presence            UserPresence?
  powerBoardRule      PowerBoardRule?
  consentRequestsMade ConsentRequest[]          @relation("ConsentRequester")
  consentRequestsRecv ConsentRequest[]          @relation("ConsentTarget")
  consentGrantsMade   ConsentGrant[]            @relation("ConsentGranter")
  consentGrantsRecv   ConsentGrant[]            @relation("ConsentGrantee")
  auditLogs           AuditLog[]

  // Payments
  subscriptions Subscription[]
  payments      Payment[]

  // Notifications
  notifications Notification[]

  // Admin
  adminAudits AdminAudit[] @relation("AdminAuditActor")

  // RBAC — 管理角色关联
  adminRoles AdminUserRole[]

  // T01 多租户 — 成员关系（模型定义见 prisma/schema/tenancy.prisma）
  memberships Membership[] @relation("UserMemberships")

  // T02 Connection OS — Mission 发起 / 参与（模型定义见 prisma/schema/connection.prisma）
  missions              Mission[]              @relation("UserMissions")
  missionParticipations MissionParticipation[] @relation("UserMissionParticipations")

  // T03 Connection OS — 成员意图与逐字段披露（模型定义见 prisma/schema/connection.prisma）
  socialIntents SocialIntent[] @relation("UserSocialIntents")

  // T05 Connection OS — 连接提案与个体表态（模型定义见 prisma/schema/connection.prisma）
  //
  // 三个关系**必须分开命名**：同一个人既可能是「发起方」也可能是「被介绍方」，
  // 若共用一个关系名，Prisma 无法确定提案的两个外键各自指向哪一侧 ——
  // 生成出来的 client 会把 proposer/candidate 混淆（编译期不报错，写入时错位）。
  proposalsMade     ConnectionProposal[] @relation("ProposalProposer")
  proposalsReceived ConnectionProposal[] @relation("ProposalCandidate")
  proposalDecisions ProposalDecision[]   @relation("UserProposalDecisions")

  // Analytics
  analyticsEvents AnalyticsEvent[]

  // Safety & Moderation
  reportsMade     UserReport[] @relation("ReportsMade")
  reportsReceived UserReport[] @relation("ReportsReceived")

  // Block List
  blocksGiven    Block[] @relation("BlockerRelations")
  blocksReceived Block[] @relation("BlockedRelations")

  // Sincerity
  sincerityWallet SincerityWallet?

  // Credit Card Verification (age + identity proof, no charge)
  cardVerified   Boolean   @default(false)
  cardVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft delete (v3.0)
  deletedAt DateTime?

  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([isBot]) // P1: AutoMatch bot 查找
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String    @id @default(cuid())
  identifier String // email address
  token      String    @unique // the 6-digit code
  expires    DateTime
  userId     String? // optional link to user
  user       User?     @relation("UserVerificationTokens", fields: [userId], references: [id], onDelete: Cascade)
  used       Boolean   @default(false)
  useCount   Int       @default(0) // Track usage count for replay attack prevention
  maxUses    Int       @default(1) // Maximum allowed uses (1 for one-time tokens)
  lastUsedAt DateTime? // Track when token was last used
  createdAt  DateTime  @default(now())

  @@unique([identifier, token])
  @@index([identifier])
  @@index([userId])
  @@index([expires])
}

// ═══════════════════════════════════════════════════════════════
// USER PROFILE — Relationship structure blueprint
// ═══════════════════════════════════════════════════════════════

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Basic Info
  displayName    String
  age            Int
  gender         Gender
  genderIdentity String? // Free text for non-binary identification
  sexuality      String // "Straight", "Bisexual", "Pansexual", "Queer", "Lesbian", "Gay", "Fluid", etc.
  bio            String?
  avatar         String? // Upload URL
  avatarType     String? // "photo" | "cartoon"
  galleryPhotos  String  @default("[]") // JSON: string[] - User photo album URLs
  city           String?
  country        String? @default("US")

  // Relationship Blueprint (核心差异化数据)
  relationshipGoal      RelationshipGoal @default(LONG_TERM)
  attachmentStyle       String? // "Secure", "Anxious-Preoccupied", "Dismissive-Avoidant", "Fearful-Avoidant"
  communicationStyle    String? // "Direct", "Reflective", "Expressive", "Analytical"
  conflictResolution    String? // "Collaborative", "Compromising", "Accommodating", "Competing", "Avoiding"
  loveLanguage          String? // "Words of Affirmation", "Quality Time", "Physical Touch", "Acts of Service", "Gifts"
  boundaries            String? // JSON array of boundary descriptions
  dealbreakers          String? // JSON array
  lifePriorities        String? // JSON array: "Career", "Family", "Adventure", "Stability", etc.
  emotionalAvailability String? // "Fully Available", "Building Trust", "Processing Past", "Needs Space"

  // ═══════════════════════════════════════════════════════════════
  // NEW: User Preference Tags for Matching (最多5个)
  // ═══════════════════════════════════════════════════════════════
  selectedTags String @default("[]") // JSON: string[] - 用户选择的标签

  // ═══════════════════════════════════════════════════════════════
  // PHASE B: Kink & Power Dynamics Profile
  // ═══════════════════════════════════════════════════════════════
  domSubRole          DomSubRole? // User's primary role identity
  preferredRole       DomSubRole? // Preferred role in a partner
  kinkExperienceLevel KinkExperienceLevel? // Experience level in kink dynamics
  kinkInterests       String               @default("[]") // JSON: string[] - selected kink categories
  hardLimits          String               @default("[]") // JSON: string[] - absolute boundaries

  // Preferences for matching
  preferredAgeMin   Int?
  preferredAgeMax   Int?
  preferredGender   String?
  preferredDistance Int? // Max distance in miles
  preferredLocation String?

  // Matching score cache (denormalized for performance)
  compatibilityScore Int? // 0-100 overall score

  // Status
  profileStatus  ProfileStatus @default(DRAFT)
  onboardingStep Int           @default(0) // 0-5, tracks onboarding progress
  isApproved     Boolean       @default(false)
  isVerified     Boolean       @default(false)

  // Personality & Matching Data (for bot users)
  personalityData String? // 完整人格数据存储（JSON字符串）

  // Admin notes
  adminNotes String?

  // Bot System Relation

  // ═══════════════════════════════════════════════════════════════
  // PRODUCT OPTIMIZATION: Elite Power Features
  // ═══════════════════════════════════════════════════════════════

  // Professional Info
  occupation        String? // Job title
  company           String? // Company name
  industry          String? // Industry sector
  linkedInVerified  Boolean @default(false)
  verificationBadge String? // "VERIFIED", "ELITE", etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gender])
  @@index([relationshipGoal])
  @@index([profileStatus])
  @@index([compatibilityScore])
  @@index([linkedInVerified])
  @@index([gender, profileStatus])
  @@index([isApproved])
  @@index([attachmentStyle]) // BUG-02 FIX: Discover API 过滤加速
  @@index([city]) // BUG-02 FIX: Discover API 城市过滤加速
  // Discover API 加速索引
  @@index([onboardingStep]) // P0: Discover/AutoMatch 核心过滤字段
  @@index([age]) // P0: 年龄范围查询
  @@index([onboardingStep, gender]) // P0: 复合过滤 (step>=N + gender=G)
  @@index([gender, age]) // P1: 先 gender 精确匹配再 age 范围查询
}

// ═══════════════════════════════════════════════════════════════
// MATCHING ENGINE — Core differentiation
// ═══════════════════════════════════════════════════════════════

model Match {
  id String @id @default(cuid())

  // Participants
  senderId   String
  sender     User   @relation("SentMatches", fields: [senderId], references: [id])
  receiverId String
  receiver   User   @relation("ReceivedMatches", fields: [receiverId], references: [id])

  // Matching Data
  matchScore       Float // 0-100 compatibility score
  matchReason      String // AI-generated explanation
  conflictWarnings String? // JSON array of potential conflicts

  // Compatibility breakdown (denormalized)
  attachmentCompat    Float? // 0-100
  communicationCompat Float? // 0-100
  conflictCompat      Float? // 0-100
  valuesCompat        Float? // 0-100
  lifestyleCompat     Float? // 0-100

  // Status
  status    MatchStatus @default(PENDING)
  matchType MatchType   @default(WEEKLY)

  // Reaction tracking
  matchReactions MatchReaction[]
  senderAction   MatchAction?
  receiverAction MatchAction?

  // Connection
  // P1-6 阶段 5：原 `chatRoom ChatRoom?` 关系随 ChatRoom 表删除而移除。
  // 会话入口改由 Conversation.matchId 反查（见 api/matches/[id]/route.ts）。

  // Admin
  reviewedBy  String?
  reviewNotes String?

  // ═══════════════════════════════════════════════════════════════
  // PRODUCT OPTIMIZATION: Elite Power Features
  // ═══════════════════════════════════════════════════════════════

  // Pitch Message (申请信)
  pitchMessage String? // 50-200字申请信
  pitchTone    String? // "casual", "sincere", "playful", "direct"
  aiAssisted   Boolean @default(false) // 是否使用AI辅助

  // Sincerity Gift (诚意值附赠)
  giftAmount Int @default(0) // 附赠诚意值数量

  // Inbox Management (收件箱管理)
  isUnread      Boolean @default(true) // 是否未读
  inboxPriority Float? // 收件箱排序权重 (计算值)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime? // Auto-expire after 7 days if not acted on

  // Soft delete (v3.0)
  deletedAt DateTime?

  @@unique([senderId, receiverId], map: "unique_match_pair")
  @@index([status])
  @@index([matchScore])
  @@index([matchType])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([senderId])
  @@index([receiverId])
  @@index([senderId, receiverId])
  @@index([receiverId, senderId]) // P2: OR 反向查询优化
  @@index([isUnread])
  @@index([inboxPriority])
  @@index([deletedAt])
}

model MatchReaction {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reaction MatchAction
  feedback String? // Optional feedback on why

  createdAt DateTime @default(now())

  @@unique([matchId, userId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════
// P1-6 阶段 5（2026-09-28）：Legacy 三表 ChatRoom / ChatRoomMember / Message
// 已从 schema 与数据库删除。血缘 126/126 已迁移至 IMMessage，门禁 GO。
// 历史与执行手册：docs/CHAT-MERGE-RUNBOOK.md · docs/CHAT-MERGE-AUDIT.md
// ═══════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════
// IM MODULE — Next-Gen Chat Infrastructure
// ═══════════════════════════════════════════════════════════════

// Conversation — logical session layer
model Conversation {
  id String @id @default(cuid())

  // Participants
  userAId     String
  userA       User   @relation("ConversationUserA", fields: [userAId], references: [id])
  userBId     String
  userB       User   @relation("ConversationUserB", fields: [userBId], references: [id])
  initiatorId String // who started the conversation

  // Backlink to ChatRoom (migration bridge)
  //
  // ⚠️ 阶段 5 的 schema 编辑必须**保留 chatRoomId 标量列与唯一索引**，只删掉
  //    `chatRoom` 关系字段（关系指向的 ChatRoom model 会被删除）。
  //    原因：改造前 user 收藏的 /dashboard/chats/<ChatRoom.id> 旧链接里没有
  //    Conversation.id，只能靠本列反查 —— 删掉它等于把老用户挡在"会话不存在"之外（G-8）。
  //    `lib/im/resolve.ts` 的路径 2 就建立在本列的 @unique 索引上。
  chatRoomId String? @unique
  // P1-6 阶段 5：原 `chatRoom ChatRoom? @relation(...)` 关系随 ChatRoom 表删除而移除。
  // 标量列 chatRoomId 与 @unique 索引**刻意保留**（G-8 旧书签别名回退，
  // 见 lib/im/resolve.ts 路径 2）。数据库侧同步删掉了本列的外键约束。

  // ═══════════════════════════════════════════════════════════════
  // 匹配关联（G-10，阶段 5 前置修复）
  //
  // 发现路径：阶段 5 的 schema 清理清单原本只列了 Vault 字段。核对 `ChatRoom` 模型时
  // 发现 `matchId` / `match.matchScore` **只存在于 ChatRoom**，而会话列表（`lib/im/list.ts`）
  // 与会话详情都在向 UI 输出 matchScore —— 删表会让"匹配分"整块消失，属静默功能回退。
  //
  // 这里刻意**只加标量列、不加 relation**：relation 会要求 Match 侧反向声明字段，
  // 扩大 schema 改动面；而 matchScore 只需要一次批量查询即可补齐（见 list.ts）。
  // ═══════════════════════════════════════════════════════════════
  matchId String?

  // State
  state       ConversationState @default(ACTIVE)
  stateReason String? // reason for state change

  // Female Control
  controllingUserId     String? // who has control (usually female)
  activeBoundaryVersion String? // current Power Board version

  // Statistics (denormalized for performance)
  lastMessageAt DateTime?
  messageCount  Int       @default(0)
  unreadCountA  Int       @default(0)
  unreadCountB  Int       @default(0)

  // Per-user settings (JSON for flexibility)
  settings String? // JSON: { userA: {muted, pinned}, userB: {muted, pinned} }

  // ═══════════════════════════════════════════════════════════════
  // Vault —— 24h 限时对话
  //
  // P1-6 阶段 4（G-1 修复）：以下字段此前**只存在于 ChatRoom**。方案 A 确定 Conversation
  // 为终局模型后，若不在删除 ChatRoom 前把它们迁移过来，阶段 5 会**整体丢失**：
  //   · 女性用户的「终结对话」权限（vaultStatus / revokedAt / revokeReason）
  //   · 24h 倒计时的延长审计（extensionCount / extendedAt / extendedBy）
  //   · 截图防护的计数与取证（screenshotCount / lastScreenshotAt）
  // 迁移脚本见 scripts/chat-merge/migrate-vault.ts（幂等 + dry-run）。
  // ═══════════════════════════════════════════════════════════════

  // Vault expiry timestamp (null = no Vault)
  vaultExpiresAt DateTime?

  // Vault 四态：ACTIVE / EXTENDED（已延长）/ REVOKED（被女性终止）/ EXPIRED（超时）
  vaultStatus VaultStatus @default(ACTIVE)

  // 延长审计
  extensionCount Int       @default(0)
  extendedAt     DateTime?
  extendedBy     String?

  // 女性特权：终止对话
  revokedAt    DateTime?
  revokedBy    String?
  revokeReason String?

  // 隐私防护
  screenshotCount  Int       @default(0)
  lastScreenshotAt DateTime?

  // Consent cache
  cachedConsentState ConsentState @default(CONSENT_NONE)

  // Relations
  participants    ConversationParticipant[]
  imMessages      IMMessage[]
  receipts        MessageReceipt[]
  consentRequests ConsentRequest[]
  consentGrants   ConsentGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft delete (v3.0)
  deletedAt DateTime?

  @@unique([userAId, userBId], map: "unique_conversation_pair")
  @@index([state])
  @@index([lastMessageAt])
  @@index([userAId])
  @@index([userBId])
  @@index([controllingUserId])
  @@index([vaultExpiresAt])
  // P1-6 阶段 4（G-1）：Vault 状态查询索引（与 ChatRoom 侧保持一致）
  @@index([vaultStatus])
  // P1-6 阶段 5（G-10）：匹配分补迁后按 matchId 反查
  @@index([matchId])
  @@index([deletedAt])
}

// ConversationParticipant — per-user conversation membership & state
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Per-user state
  isMuted     Boolean   @default(false)
  isPinned    Boolean   @default(false)
  isArchived  Boolean   @default(false)
  lastReadSeq Int       @default(0) // last read sequence number
  lastReadAt  DateTime?

  // Subscription
  subscribedAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([userId, isMuted])
  @@index([userId, isPinned])
}

// IMMessage — next-gen message model
model IMMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Core fields
  clientMsgId String? @unique // client-generated ID for dedup

  // P1-6 阶段 3 迁移桥：指向被迁移的 Legacy Message.id。
  // 幂等锚点 —— 迁移脚本以此字段判定"已迁/未迁"，绝不重复插入。
  // 阶段 5（Legacy 表删除后）可安全移除本字段。
  legacyMessageId String? @unique

  senderId   String
  sender     User   @relation("IMMessageSender", fields: [senderId], references: [id])
  receiverId String
  seq        Int // server-assigned sequence number (monotonic per conversation)

  // Content
  msgType  IMMessageType @default(TEXT)
  payload  String // message content (plaintext or E2EE ciphertext)
  metadata String? // JSON: media info, links, etc.

  // Encryption
  encryptionMode     EncryptionMode @default(SERVER)
  ephemeralPublicKey String? // for E2EE key exchange

  // Boundary & compliance
  boundaryVersion String? // current Power Board version
  complianceTags  String           @default("[]") // JSON: string[] - ["consent_granted", "media_level_2", "pace_ok"]
  consentState    ConsentState     @default(CONSENT_NONE)
  mediaLevel      MediaAccessLevel @default(L0_TEXT)
  ruleResult      RuleEngineResult @default(PASS)

  // Reply
  replyToMsgId   String?
  replyToPreview String? // JSON: {msgId, senderId, previewText, mediaLevel}

  // Edit & Delete
  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String? // who deleted (sender or admin)

  // Media metadata
  mediaMetadata String? // JSON: {mediaId, level, mimeType, sizeBytes, width, height, durationMs, thumbnailUrl, watermarkHash, isExpiring, expiresAt}

  // Delivery status
  status MessageDeliveryStatus @default(SENT)

  // Receipts
  receipts MessageReceipt[]

  // Reactions
  reactions MessageReaction[]

  createdAt DateTime @default(now())

  @@index([conversationId, seq])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([receiverId])
  @@index([clientMsgId])
  @@index([createdAt])
  @@index([msgType])
  @@index([isDeleted])
}

// MessageReceipt — per-recipient delivery & read receipts
model MessageReceipt {
  id             String       @id @default(cuid())
  messageId      String
  message        IMMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String // who this receipt belongs to
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Receipt state
  deliveredAt DateTime? // when message was delivered to this user
  readAt      DateTime? // when message was read by this user

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@index([conversationId])
}

// MessageReaction — emoji reactions on messages
model MessageReaction {
  id        String    @id @default(cuid())
  messageId String
  message   IMMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Emoji character
  emoji String

  createdAt DateTime @default(now())

  // Each user can only add one reaction per emoji per message
  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

// UserPresence — online/offline status tracking
model UserPresence {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Presence state
  status        PresenceStatus @default(OFFLINE)
  statusMessage String? // custom status text
  lastSeenAt    DateTime? // last heartbeat / activity timestamp

  // Device info
  deviceId   String? // current active device
  platform   String? // "ios", "android", "web"
  appVersion String? // client version

  // Connection
  connectionId String? // WebSocket connection ID
  connectedAt  DateTime? // when current session started

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lastSeenAt])
  @@index([userId, status])
}

// ═══════════════════════════════════════════════════════════════
// CONSENT MANAGEMENT — Granular permission control
// ═══════════════════════════════════════════════════════════════

model ConsentRequest {
  id             String       @id @default(cuid())
  requesterId    String
  requester      User         @relation("ConsentRequester", fields: [requesterId], references: [id])
  targetId       String
  target         User         @relation("ConsentTarget", fields: [targetId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Request details
  consentType    ConsentRequestType @default(MEDIA)
  requestedLevel MediaAccessLevel   @default(L0_TEXT)
  contextMsgId   String? // message that triggered this request
  reason         String? // user-visible reason

  // Preview (encrypted)
  previewPayload String? // encrypted preview content

  // State
  state        ConsentState @default(CONSENT_PENDING)
  respondedAt  DateTime?
  responseNote String?
  grantToken   String?      @unique // authorization token for verification

  // Validity
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([requesterId])
  @@index([targetId])
  @@index([conversationId])
  @@index([state])
  @@index([expiresAt])
  @@index([consentType])
}

model ConsentGrant {
  id             String       @id @default(cuid())
  granterId      String
  granter        User         @relation("ConsentGranter", fields: [granterId], references: [id])
  granteeId      String
  grantee        User         @relation("ConsentGrantee", fields: [granteeId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Grant details
  consentType  ConsentRequestType @default(MEDIA)
  grantedLevel MediaAccessLevel   @default(L0_TEXT)

  // Validity
  grantedAt DateTime  @default(now())
  expiresAt DateTime? // null = permanent

  // Revocation
  isRevoked Boolean   @default(false)
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([granterId])
  @@index([granteeId])
  @@index([conversationId])
  @@index([consentType])
  @@index([isRevoked])
  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════════
// POWER BOARD — Rule engine for boundary control
// ═══════════════════════════════════════════════════════════════

model PowerBoardRule {
  id     String @id @default(cuid())
  userId String @unique // each user has one active rule set
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Version control
  version  String  @default("1.0.0") // semantic versioning
  isActive Boolean @default(true)

  // Pace Control (JSON)
  paceConfig String // JSON: {maxMessagesPerHour, maxMessagesPerDay, responseWindowHours, enforceCooldown, cooldownMinutes, showRemainingQuota}

  // Media Policy (JSON)
  mediaConfig String // JSON: {defaultLevel, perUserOverride, requireConsentForUpgrade, autoBlurImages, watermarkAllMedia}

  // Content Filter (JSON)
  filterConfig String // JSON: {blockedKeywords, blockedPatterns, blockExplicitImages, autoFlagProfanity, blockUnsolicitedContact, sensitivityLevel}

  // Auto Response (JSON)
  autoResponse String? // JSON: {enabled, messageTemplate, triggerAfterHours, onlyFirstMessage}

  // Privacy Settings (JSON)
  privacyConfig String // JSON: {preferredEncryption, allowScreenshotNotifications, autoExpireMessages, expireAfterDays, hideOnlineStatus, hideReadReceipts}

  // Notification Preferences (JSON)
  notifConfig String? // JSON: {pushEnabled, soundEnabled, previewEnabled, quietHoursEnabled, quietHoursStart, quietHoursEnd}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([version])
  @@index([isActive])
}

// ═══════════════════════════════════════════════════════════════
// AUDIT LOG — Immutable audit trail with hash chain
// ═══════════════════════════════════════════════════════════════

model AuditLog {
  id             String  @id @default(cuid())
  userId         String // who this log belongs to
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String? // related conversation

  // Action details
  action   String // "boundary_changed", "consent_granted", "message_blocked", "rule_violation", "security_event"
  actorId  String? // who performed the action
  targetId String? // who was affected

  // Details (JSON - varies by action type)
  details String? // JSON with full context

  // Hash chain (tamper detection)
  prevHash  String? // hash of previous entry
  entryHash String // hash of this entry

  // Metadata
  ipAddress String?
  userAgent String?
  deviceId  String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([action])
  @@index([actorId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════════════════════════

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  body      String
  data      String? // JSON payload for deep links
  actionUrl String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// PAYMENTS & SUBSCRIPTIONS
// ═══════════════════════════════════════════════════════════════

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan
  status SubscriptionStatus @default(ACTIVE)

  // Stripe
  stripeCustomerId       String?   @unique
  stripePriceId          String?
  stripeSubscriptionId   String?   @unique
  stripeCurrentPeriodEnd DateTime?

  // Matching perks
  weeklyMatchLimit   Int     @default(5)
  canInitiateChat    Boolean @default(true)
  canViewFullProfile Boolean @default(true)

  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft delete (v3.0)
  deletedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([deletedAt])
  @@index([userId, status])
}

model Payment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripePaymentIntentId String?       @unique
  amount                Float // In USD
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)

  description String?
  metadata    String? // JSON

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft delete (v3.0)
  deletedAt DateTime?

  @@index([userId])
  @@index([deletedAt])
  @@index([createdAt, status])
}

// ═══════════════════════════════════════════════════════════════
// ADMIN & ANALYTICS
// ═══════════════════════════════════════════════════════════════

// 统一管理审计日志 (v3.0: 合并 AdminLog + AdminRoleAudit)
model AdminAudit {
  id String @id @default(cuid())

  // 操作者
  actorId String
  actor   User   @relation("AdminAuditActor", fields: [actorId], references: [id])

  // 分类
  category AuditCategory // "user" | "match" | "payment" | "rbac" | "system" | ...

  // 操作
  action String // "create" | "update" | "delete" | "ban" | "grant_role" | ...

  // 目标对象
  targetType String? // "User" | "Match" | "Payment" | "AdminRole" | ...
  targetId   String? // 目标记录 ID

  // 变更内容
  changes String? // JSON: { before: {...}, after: {...} }
  details String? // 额外上下文

  // 原因（RBAC 变更等需要理由的操作）
  reason String?

  // 元数据
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([category, createdAt])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// 审计分类枚举 (v3.0)
enum AuditCategory {
  USER
  MATCH
  CHAT
  PAYMENT
  CONTENT
  BOT
  AI_CREATIVE
  AI_SUPPORT
  VIP
  ANALYTICS
  SYSTEM
  RBAC
}

model AnalyticsEvent {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  event         String // "user.registered", "swipe.right", "message.sent", etc.
  eventCategory String  @default("") // "user"|"match"|"chat"|"revenue"|"admin"
  properties    String? // JSON with event data

  sessionId  String?
  deviceId   String  @default("") // device fingerprint
  pagePath   String  @default("") // page path
  platform   String  @default("web") // web|ios|android
  appVersion String  @default("") // app version

  ipAddress String?
  country   String? // GeoIP country
  city      String? // GeoIP city

  // UTM tracking
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  createdAt DateTime @default(now())

  @@index([userId, event, createdAt])
  @@index([event, createdAt])
  @@index([eventCategory, createdAt])
  @@index([sessionId])
  @@index([createdAt])
}

model SystemConfig {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

// ═══════════════════════════════════════════════════════════════
// RBAC — Role-Based Access Control (管理后台权限系统)
// ═══════════════════════════════════════════════════════════════

// 管理员角色枚举
enum AdminRole {
  SUPER_ADMIN // 超级管理员：全部权限，可管理其他管理员和角色
  ADMIN // 管理员：用户/匹配/内容/支付全管理
  MODERATOR // 审核员：举报审核/内容审核/用户封禁
  ANALYST // 分析师：只读数据分析，可导出
  SUPPORT // 客服：用户查看+基础操作，举报处理
  CREATIVE // 创意运营：AI推广图全管理
  VIP_AGENT // VIP客服：VIP收件箱专属
}

// 权限分类
enum PermissionCategory {
  USER // 用户管理
  MATCHING // 匹配管理
  CHAT // 聊天管理
  PAYMENT // 支付管理
  CONTENT // 内容审核
  AI_CREATIVE // AI推广图
  AI_SUPPORT // AI客服
  VIP // VIP管理
  ANALYTICS // 数据分析
  SYSTEM // 系统配置
  RBAC // 权限管理
  BOT // Bot系统
}

// 单个权限定义
model AdminPermission {
  id          String             @id @default(cuid())
  code        String             @unique // "user.view", "user.ban", "payment.refund"
  name        String // "查看用户", "封禁用户", "退款操作"
  description String?
  category    PermissionCategory

  // 元数据
  isActive    Boolean  @default(true)
  isDangerous Boolean  @default(false) // 高危权限（如删除/退款）需二次确认
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联
  rolePermissions AdminRolePermission[]

  @@index([category])
  @@index([isActive])
}

// 自定义角色 — 管理员可在 UI 中动态创建（v3.0+）
model CustomRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // 系统角色不可删除
  permissions String // JSON数组: '["user.view","user.ban",...]'（SQLite不支持原生数组）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles AdminUserRole[]

  @@index([isSystem])
}

// 角色-权限关联（多对多）
model AdminRolePermission {
  id           String          @id @default(cuid())
  role         AdminRole
  permissionId String
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  grantedAt DateTime @default(now())
  grantedBy String? // 授权人ID

  // 复合唯一约束
  @@unique([role, permissionId])
  @@index([role])
}

// 管理员-角色关联（多对多：一个管理员可有多个角色）
model AdminUserRole {
  id String @id @default(cuid())

  // 关联到 User 表（复用现有 User 模型）
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role AdminRole

  // 自定义角色扩展（v3.0+）：可选，叠加在系统角色之上
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id])

  // 管理员扩展信息
  department String? // "operations", "safety", "growth", "creative", "vip", "finance"
  title      String? // "运营经理", "客服主管"
  isActive   Boolean @default(true)

  // 时间
  grantedAt DateTime  @default(now())
  grantedBy String? // 授权人ID
  expiresAt DateTime? // 过期时间（可选，用于临时权限）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
}

